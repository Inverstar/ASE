          <a href="https://feargreedindex.world" target="_blank" rel="noopener noreferrer" class="gt-btn gt-btn-cmc">FGI World ↗</a>
          <a href="https://econix.ai.kr/zh/dashboard" target="_blank" rel="noopener noreferrer" class="gt-btn gt-btn-econix">Econix AI ↗</a>
          <button id="gt-reset-layout" class="gt-btn gt-btn-reset">重置 Ace 布局 ↺</button>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

    </div><!-- /gt-board -->
