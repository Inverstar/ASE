          </div>
          <h2 class="gt-panel-title text-sent">综合情绪温度</h2>
          <span class="gt-source">情绪百分位</span>
        </div>
        <div class="gt-widget-body">
          <div class="gt-gauge-box">
            <svg viewBox="0 0 200 105" class="gt-gauge">
              <path d={gaugeArc(NGCX, NGCY, NGR, 0, 20)} stroke="#16c784" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 20, 40)} stroke="#84cc16" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 40, 60)} stroke="#eab308" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 60, 80)} stroke="#f97316" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 80, 100)} stroke="#ea3943" stroke-width="12" fill="none" opacity="0.85" />
              {(() => {
                const angleVal = Math.max(0, Math.min(100, sentimentTempVal));
                const pct = angleVal / 100;
                return (
                  <line 
                    x1={NGCX} y1={NGCY} 
                    x2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).x.toFixed(2)} 
                    y2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).y.toFixed(2)} 
                    stroke={getTempState(sentimentTempVal).color} stroke-width="3" stroke-linecap="round" 
                  />
                );
              })()}
              <circle cx={NGCX} cy={NGCY} r="5" fill={getTempState(sentimentTempVal).color}/>
              <circle cx={NGCX} cy={NGCY} r="2.5" fill="var(--block-bg)"/>
              <text x={NGCX} y={NGCY - 14} text-anchor="middle" font-size="25" font-weight="800" fill={getTempState(sentimentTempVal).color}>{sentimentTempVal.toFixed(1)}%</text>
              <text x={NGCX} y={NGCY - 1} text-anchor="middle" font-size="8.5" font-weight="700" fill="var(--text-primary)">{getTempState(sentimentTempVal).text}</text>
            </svg>
            <p class="gt-gauge-desc">情绪指标 10年分位中位数</p>
          </div>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

