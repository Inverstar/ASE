---
import Layout from '../layouts/Layout.astro';
import { generateChinaIndicatorData } from '../utils/sentiment';

// Helper functions for dynamic calculations
function polar(cx: number, cy: number, r: number, deg: number) {
  const rad = (deg * Math.PI) / 180;
  return { x: cx + r * Math.cos(rad), y: cy - r * Math.sin(rad) };
}

function gaugeArc(cx: number, cy: number, r: number, fromVal: number, toVal: number, scaleMin = 0, scaleMax = 100) {
  const fromPct = (fromVal - scaleMin) / (scaleMax - scaleMin);
  const toPct = (toVal - scaleMin) / (scaleMax - scaleMin);
  const fromDeg = 180 - fromPct * 180;
  const toDeg = 180 - toPct * 180;
  const p1 = polar(cx, cy, r, fromDeg);
  const p2 = polar(cx, cy, r, toDeg);
  const large = Math.abs(toPct - fromPct) > 0.5 ? 1 : 0;
  return `M ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} A ${r} ${r} 0 ${large} 0 ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
}

// Valuation temp colors: Green/Teal (cheap) to Red (expensive)
function getTempState(v: number) {
  if (v <= 20) return { text: '极度低估', color: '#16c784' };
  if (v <= 40) return { text: '估值偏低', color: '#84cc16' };
  if (v <= 60) return { text: '估值合理', color: '#eab308' };
  if (v <= 80) return { text: '估值偏高', color: '#f97316' };
  return { text: '极度高估', color: '#ea3943' };
}

// China FGI colors: Red (fear) to Green (greed)
function getFgiState(v: number) {
  if (v <= 25) return { text: '极度恐惧', color: '#ea3943' };
  if (v <= 45) return { text: '情绪恐慌', color: '#f97316' };
  if (v <= 55) return { text: '情绪中性', color: '#eab308' };
  if (v <= 75) return { text: '情绪贪婪', color: '#84cc16' };
  return { text: '极度贪婪', color: '#16c784' };
}

function getVolumeState(v: number) {
  if (v < 8000) return { text: '成交地量', color: '#94a3b8' };
  if (v <= 12000) return { text: '常态温和', color: '#84cc16' };
  if (v <= 18000) return { text: '活跃放量', color: '#eab308' };
  return { text: '天量狂热', color: '#ea3943' };
}

function getRsiState(v: number) {
  if (v < 30) return { text: '超卖区域', color: '#16c784' };
  if (v <= 70) return { text: '合理区间', color: '#eab308' };
  return { text: '超买预警', color: '#ea3943' };
}

function getBaifenweiState(pct: number) {
  if (pct <= 20) return { text: '极冷', color: '#16c784' };
  if (pct <= 40) return { text: '偏冷', color: '#84cc16' };
  if (pct <= 60) return { text: '正常', color: '#eab308' };
  if (pct <= 80) return { text: '偏热', color: '#f97316' };
  return { text: '极热', color: '#ea3943' };
}

// Generate indicator walks
const sentimentData = generateChinaIndicatorData();

// Extract metrics
const chinaFgiVal = sentimentData.chinaFgi.currentValue;
const chinaFgiHistory = sentimentData.chinaFgi.historicalData;

const aShareTempVal = sentimentData.aShareTemp.currentValue;
const aShareTempHistory = sentimentData.aShareTemp.historicalData;

const hkTempVal = sentimentData.hkTemp.currentValue;
const hkTempHistory = sentimentData.hkTemp.historicalData;

const chinaInternetTempVal = sentimentData.chinaInternetTemp.currentValue;
const chinaInternetTempHistory = sentimentData.chinaInternetTemp.historicalData;

const sentimentTempVal = sentimentData.sentimentTemp.currentValue;
const sentimentTempHistory = sentimentData.sentimentTemp.historicalData;

const volumeVal = sentimentData.volume.currentValue;
const volumeHistory = sentimentData.volume.historicalData;

const rsiVal = sentimentData.rsi.currentValue;
const rsiHistory = sentimentData.rsi.historicalData;

const hs300Pe = sentimentData.hs300Pe;
const hs300Pb = sentimentData.hs300Pb;
const hs300Ps = sentimentData.hs300Ps;

const breadthVal = sentimentData.breadth.currentValue;
const breadthHistory = sentimentData.breadth.historicalData;


// FGI.world metrics
const aShareFgiVal = sentimentData.aShareFgi.currentValue;
const aShareFgiHistory = sentimentData.aShareFgi.historicalData;

const hkFgiVal = sentimentData.hkFgi.currentValue;
const hkFgiHistory = sentimentData.hkFgi.historicalData;

// Sector Index metrics
const sectorAi = sentimentData.sectorAi;
const sectorSemiconductor = sentimentData.sectorSemiconductor;
const sector3rdSemi = sentimentData.sector3rdSemi;

// Gauge constant metrics
const NGCX = 100, NGCY = 92, NGR = 72;
