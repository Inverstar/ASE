<!-- Inject Chart.js preloads in Browser -->
<script is:inline src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>

<script>
  // Immediately read and set theme to avoid FOUC
  const savedTheme = (() => {
    try {
      return localStorage.getItem('gt-theme-v2') || 'paper';
    } catch (e) {
      return 'paper';
    }
  })();
  document.documentElement.setAttribute('data-theme', savedTheme);

  document.addEventListener('DOMContentLoaded', () => {
    // Register plugins
    if (window.Chart && window.chartjsPluginAnnotation && window.chartjsPluginZoom) {
      window.Chart.register(window.chartjsPluginAnnotation);
      window.Chart.register(window.chartjsPluginZoom);
    }

    // --- Color mapping helper functions ---
    const getThemeColors = () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      const isPaper = document.documentElement.getAttribute('data-theme') === 'paper';
      return {
        gridColor: isLight ? 'rgba(0, 0, 0, 0.05)' : isPaper ? 'rgba(74, 53, 37, 0.07)' : 'rgba(255, 255, 255, 0.06)',
        textColor: isLight ? '#475569' : isPaper ? '#6b4a32' : '#94a3b8'
      };
    };

    const getFgiColor = (v: number) => {
      if (v <= 25) return "#ea3943";
      if (v <= 45) return "#f97316";
      if (v <= 55) return "#eab308";
      if (v <= 75) return "#84cc16";
      return "#16c784";
    };

    const getFgiBg = (v: number) => {
      const hex = getFgiColor(v);
      if (hex === "#ea3943") return "rgba(234, 57, 67, 0.04)";
      if (hex === "#f97316") return "rgba(249, 115, 22, 0.04)";
      if (hex === "#eab308") return "rgba(234, 179, 8, 0.04)";
      if (hex === "#84cc16") return "rgba(132, 204, 22, 0.04)";
      return "rgba(22, 199, 132, 0.04)";
    };

    const getFgiLineGradient = (ctx: CanvasRenderingContext2D, chartArea: any) => {
      const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
      gradient.addColorStop(0, "#ea3943");
      gradient.addColorStop(0.25, "#ea3943");
      gradient.addColorStop(0.25, "#f97316");
      gradient.addColorStop(0.45, "#f97316");
      gradient.addColorStop(0.45, "#eab308");
      gradient.addColorStop(0.55, "#eab308");
      gradient.addColorStop(0.55, "#84cc16");
      gradient.addColorStop(0.75, "#84cc16");
      gradient.addColorStop(0.75, "#16c784");
      gradient.addColorStop(1, "#16c784");
      return gradient;
    };

    const getFgiBgGradient = (ctx: CanvasRenderingContext2D, chartArea: any) => {
      const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
      gradient.addColorStop(0, "rgba(234, 57, 67, 0.04)");
      gradient.addColorStop(0.25, "rgba(234, 57, 67, 0.04)");
      gradient.addColorStop(0.25, "rgba(249, 115, 22, 0.04)");
      gradient.addColorStop(0.45, "rgba(249, 115, 22, 0.04)");
      gradient.addColorStop(0.45, "rgba(234, 179, 8, 0.04)");
      gradient.addColorStop(0.55, "rgba(234, 179, 8, 0.04)");
      gradient.addColorStop(0.55, "rgba(132, 204, 22, 0.04)");
      gradient.addColorStop(0.75, "rgba(132, 204, 22, 0.04)");
      gradient.addColorStop(0.75, "rgba(22, 199, 132, 0.04)");
      gradient.addColorStop(1, "rgba(22, 199, 132, 0.04)");
      return gradient;
    };

    const getDxyLineGradient = (ctx: CanvasRenderingContext2D, chartArea: any) => {
      const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
      // DXY ranges 95 to 110 on Y axis.
      // DXY <= 99 (offset 0.267) is Green (#16c784)
      // DXY 99 to 103 (offset 0.533) is Lime (#84cc16)
      // DXY 103 to 106 (offset 0.733) is Yellow (#eab308)
      // DXY >= 106 is Red (#ea3943)
      gradient.addColorStop(0, "#16c784");
      gradient.addColorStop(0.267, "#16c784");
      gradient.addColorStop(0.267, "#84cc16");
      gradient.addColorStop(0.533, "#84cc16");
      gradient.addColorStop(0.533, "#eab308");
      gradient.addColorStop(0.733, "#eab308");
      gradient.addColorStop(0.733, "#ea3943");
      gradient.addColorStop(1, "#ea3943");
      return gradient;
    };

    const getDxyBgGradient = (ctx: CanvasRenderingContext2D, chartArea: any) => {
      const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
      gradient.addColorStop(0, "rgba(22, 199, 132, 0.04)");
      gradient.addColorStop(0.267, "rgba(22, 199, 132, 0.04)");
      gradient.addColorStop(0.267, "rgba(132, 204, 22, 0.04)");
      gradient.addColorStop(0.533, "rgba(132, 204, 22, 0.04)");
      gradient.addColorStop(0.533, "rgba(234, 179, 8, 0.04)");
      gradient.addColorStop(0.733, "rgba(234, 179, 8, 0.04)");
      gradient.addColorStop(0.733, "rgba(234, 57, 67, 0.04)");
      gradient.addColorStop(1, "rgba(234, 57, 67, 0.04)");
      return gradient;
    };

    // --- Double Trend Charts Initialization ---
    const chartInstances: Record<string, any> = {};

    function initDoubleChart(canvasId: string, optionsMap: any) {
      const canvas = document.getElementById(canvasId) as HTMLCanvasElement | null;
      if (!canvas) return;

      const historyDataStr1 = canvas.getAttribute("data-history-1");
      const historyDataStr2 = canvas.getAttribute("data-history-2");
      if (!historyDataStr1 || !historyDataStr2) return;

      const hist1 = JSON.parse(historyDataStr1);
      const hist2 = JSON.parse(historyDataStr2);

      const label1 = canvas.getAttribute("data-label-1") || "Line 1";
      const label2 = canvas.getAttribute("data-label-2") || "Line 2";

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      function getFilteredDataset(list: any[], days: number) {
        return list.slice(-days);
      }

      const colors = getThemeColors();

      const render = (days: number) => {
        const d1 = getFilteredDataset(hist1, days);
        const d2 = getFilteredDataset(hist2, days);

        // Timestamps labels
        const labels = d1.map((item: any) =>
          new Date(item.timestamp).toLocaleDateString("zh-CN", {
            month: "short",
            day: "numeric",
          })
        );

        const v1 = d1.map((item: any) => {
          if (item.value !== undefined) return item.value;
          if (item.bullish !== undefined) return item.bullish;
          return item;
        });
        
        const v2 = d2.map((item: any) => {
          if (item.value !== undefined) return item.value;
          if (item.bullish !== undefined) return item.bullish;
          return item;
        });

        if (chartInstances[canvasId]) {
          chartInstances[canvasId].destroy();
        }

        chartInstances[canvasId] = new window.Chart(ctx, {
          type: "line",
          data: {
            labels: labels,
            datasets: [
              {
                label: label1,
                data: v1,
                yAxisID: "y",
                borderColor: function (context: any) {
                  const chart = context.chart;
                  const { ctx: chartCtx, chartArea } = chart;
                  if (!chartArea) return "#f59e0b";
                  if (canvasId === "dxy-us10y-chart") {
                    return getDxyLineGradient(chartCtx, chartArea);
                  }
                  return getFgiLineGradient(chartCtx, chartArea);
                },
                backgroundColor: function (context: any) {
                  const chart = context.chart;
                  const { ctx: chartCtx, chartArea } = chart;
                  if (!chartArea) return "rgba(245, 158, 11, 0.04)";
                  if (canvasId === "dxy-us10y-chart") {
                    return getDxyBgGradient(chartCtx, chartArea);
                  }
                  return getFgiBgGradient(chartCtx, chartArea);
                },
                borderWidth: 2,
                pointRadius: 0,
                pointHoverRadius: 5,
                fill: true,
                tension: 0.15,
              },
              {
                label: label2,
                data: v2,
                yAxisID: "y1",
                borderColor: "#3b82f6",
                borderWidth: 1.8,
                borderDash: [4, 4],
                pointRadius: 0,
                pointHoverRadius: 5,
                fill: false,
                tension: 0.15,
              }
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
              mode: "index",
              intersect: false,
            },
            scales: {
              y: {
                type: "linear",
                display: true,
                position: "left",
                min: optionsMap.yMin ?? 0,
                max: optionsMap.yMax ?? 100,
                ticks: {
                  color: colors.textColor,
                  font: { size: 9 },
                },
                grid: {
                  color: colors.gridColor,
                }
              },
              y1: {
                type: "linear",
                display: true,
                position: "right",
                min: optionsMap.y1Min ?? 0,
                max: optionsMap.y1Max ?? 100,
                ticks: {
                  color: "#3b82f6",
                  font: { size: 9 },
                },
                grid: {
                  drawOnChartArea: false, // Don't overlay grid lines
                }
              },
              x: {
                grid: { display: false },
                ticks: {
                  maxRotation: 0,
                  autoSkip: true,
                  maxTicksLimit: 6,
                  color: colors.textColor,
                  font: { size: 9 },
                }
              }
            },
            plugins: {
              legend: {
                display: true,
                labels: {
                  color: colors.textColor,
                  font: { size: 9 },
                  boxWidth: 20
                }
              },
              tooltip: {
                backgroundColor: "rgba(10, 10, 20, 0.95)",
                titleColor: "#fff",
                bodyColor: "#fff",
                borderColor: "rgba(255,255,255,0.1)",
                borderWidth: 1,
              }
            }
          }
        });
      };

      render(30);
      (canvas as any)._updateChartRange = render;
    }

    // Init the 3 global macro double-line charts
    initDoubleChart("cnn-vix-chart", { yMin: 0, yMax: 100, y1Min: 10, y1Max: 50 });
    initDoubleChart("aaii-naaim-chart", { yMin: 0, yMax: 100, y1Min: 0, y1Max: 120 });
    initDoubleChart("dxy-us10y-chart", { yMin: 95, yMax: 110, y1Min: 2.0, y1Max: 6.0 });

    // Range buttons click logic
    const tabContainers = document.querySelectorAll(".gt-chart-tabs[data-target]");
    tabContainers.forEach((container) => {
      const target = container.getAttribute("data-target");
      const canvas = document.getElementById(`${target}-chart`) as any;
      if (!canvas) return;

      const buttons = container.querySelectorAll(".gt-tab-btn");
      buttons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          buttons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          const range = parseInt(btn.getAttribute("data-range") || "30", 10);
          if (canvas._updateChartRange) {
            canvas._updateChartRange(range);
          }
        });
      });
    });

    // Theme toggler
    const themeBtns = document.querySelectorAll("[data-theme-val]");
    function setTheme(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      themeBtns.forEach((btn) => {
        if (btn.getAttribute("data-theme-val") === theme) {
          btn.classList.add("gt-active");
        } else {
          btn.classList.remove("gt-active");
        }
      });
      try {
        localStorage.setItem('gt-theme-v2', theme);
      } catch (err) {}

      // Update Chart.js themes dynamically
      const colors = getThemeColors();
      Object.values(chartInstances).forEach((chart: any) => {
        if (chart?.options?.scales) {
          chart.options.scales.y.grid.color = colors.gridColor;
          chart.options.scales.y.ticks.color = colors.textColor;
          chart.options.scales.x.ticks.color = colors.textColor;
          if (chart.options.plugins?.legend?.labels) {
            chart.options.plugins.legend.labels.color = colors.textColor;
          }
          chart.update();
        }
      });
    }

    setTheme(savedTheme);
    themeBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const val = btn.getAttribute("data-theme-val");
        if (val) setTheme(val);
      });
    });

    // --- Grid Layout Engine (Separate for Global Panel: gt-layout-grid-global-v1) ---
    const container = document.querySelector(".gt-board") as HTMLElement | null;
    if (!container) return;

    const defaultLayout = {
      "vix-index": { col: 1, row: 1, w: 1, h: 1 },
      "aaii-index": { col: 2, row: 1, w: 1, h: 1 },
      "naaim-index": { col: 3, row: 1, w: 1, h: 1 },
      "pcr-index": { col: 4, row: 1, w: 1, h: 1 },
      "dxy-index": { col: 5, row: 1, w: 1, h: 1 },
      "us10y-index": { col: 6, row: 1, w: 1, h: 1 },
      "cnn-vix-trend": { col: 1, row: 2, w: 6, h: 2 },
      "aaii-naaim-trend": { col: 1, row: 4, w: 6, h: 2 },
      "dxy-us10y-trend": { col: 1, row: 6, w: 6, h: 2 },
      nav: { col: 1, row: 8, w: 6, h: 1 },
    };

    let layout = {} as any;
    try {
      const saved = localStorage.getItem("gt-layout-grid-global-v4");
      if (saved) {
        layout = JSON.parse(saved);
      }
    } catch (e) {
      console.error("Failed to load global grid layout:", e);
    }

    // Merge missing layout config keys
    Object.keys(defaultLayout).forEach((key) => {
      if (!layout[key] || typeof layout[key].col !== "number") {
        layout[key] = { ...(defaultLayout as any)[key] };
      }
    });

    const blocks = container.querySelectorAll(".gt-block");

    function applyLayout() {
      blocks.forEach((block) => {
        const id = block.getAttribute("data-id");
        if (id && layout[id]) {
          const cfg = layout[id];
          const el = block as HTMLElement;
          el.style.gridColumn = `${cfg.col} / span ${cfg.w}`;
          el.style.gridRow = `${cfg.row} / span ${cfg.h}`;
        }
      });
    }

    function updateRowHeight() {
      const width = container!.getBoundingClientRect().width;
      const colWidth = width / 6;
      container!.style.setProperty("--row-height", `${colWidth.toFixed(1)}px`);
    }

    applyLayout();
    updateRowHeight();

    window.addEventListener("resize", () => {
      updateRowHeight();
      Object.values(chartInstances).forEach((chart: any) => chart.resize());
    });

    // Reset button listener
    const resetBtn = document.getElementById("gt-reset-layout");
    if (resetBtn) {
      resetBtn.addEventListener("click", (e) => {
        e.preventDefault();
        try {
          localStorage.removeItem("gt-layout-grid-global-v4");
        } catch (err) {}
        layout = JSON.parse(JSON.stringify(defaultLayout));
        applyLayout();
        updateRowHeight();
      });
    }

    // Drag / Resize mechanics
    const ghost = document.createElement("div");
    ghost.className = "gt-grid-ghost";
    ghost.style.display = "none";
    container.appendChild(ghost);

    let activeId: string | null = null;
    let isDragging = false;
    let isResizing = false;

    let initialMouseX = 0;
    let initialMouseY = 0;
    let initialCol = 1;
    let initialRow = 1;
    let initialWSpan = 1;
    let initialHSpan = 1;
    let initialWidth = 0;
    let initialHeight = 0;

    let blockRect: DOMRect | null = null;
    let containerRect: DOMRect | null = null;
    let currentBlockEl: HTMLElement | null = null;

    container.addEventListener("mousedown", (e) => {
      if ((e.target as HTMLElement).closest("a") || (e.target as HTMLElement).closest("button")) {
        return;
      }

      const handle = (e.target as HTMLElement).closest(".gt-drag-handle");
      const resize = (e.target as HTMLElement).closest(".gt-resize-handle");

      if (handle) {
        e.preventDefault();
        currentBlockEl = handle.closest(".gt-block") as HTMLElement;
        if (!currentBlockEl) return;

        activeId = currentBlockEl.getAttribute("data-id");
        isDragging = true;

        containerRect = container.getBoundingClientRect();
        blockRect = currentBlockEl.getBoundingClientRect();

        initialMouseX = e.clientX;
        initialMouseY = e.clientY;

        const cfg = layout[activeId!];
        initialCol = cfg.col;
        initialRow = cfg.row;
        initialWSpan = cfg.w;
        initialHSpan = cfg.h;

        currentBlockEl.classList.add("gt-dragging");

        ghost.style.gridColumn = currentBlockEl.style.gridColumn;
        ghost.style.gridRow = currentBlockEl.style.gridRow;
        ghost.style.display = "block";
      } else if (resize) {
        e.preventDefault();
        currentBlockEl = resize.closest(".gt-block") as HTMLElement;
        if (!currentBlockEl) return;

        activeId = currentBlockEl.getAttribute("data-id");
        isResizing = true;

        containerRect = container.getBoundingClientRect();
        blockRect = currentBlockEl.getBoundingClientRect();

        initialMouseX = e.clientX;
        initialMouseY = e.clientY;

        initialWidth = blockRect.width;
        initialHeight = blockRect.height;

        const cfg = layout[activeId!];
        initialCol = cfg.col;
        initialRow = cfg.row;
        initialWSpan = cfg.w;
        initialHSpan = cfg.h;

        currentBlockEl.classList.add("gt-resizing");

        ghost.style.gridColumn = currentBlockEl.style.gridColumn;
        ghost.style.gridRow = currentBlockEl.style.gridRow;
        ghost.style.display = "block";
      }
    });

    document.addEventListener("mousemove", (e) => {
      if (!activeId || !currentBlockEl) return;

      containerRect = container.getBoundingClientRect();
      const colWidth = containerRect.width / 6;

      if (isDragging) {
        const deltaX = e.clientX - initialMouseX;
        const deltaY = e.clientY - initialMouseY;

        const mouseRelativeX = e.clientX - containerRect.left;
        const mouseRelativeY = e.clientY - containerRect.top;

        let targetCol = Math.floor(mouseRelativeX / colWidth) + 1;
        let targetRow = Math.floor(mouseRelativeY / colWidth) + 1;

        targetCol = Math.max(1, Math.min(6 - initialWSpan + 1, targetCol));
        targetRow = Math.max(1, targetRow);

        ghost.style.gridColumn = `${targetCol} / span ${initialWSpan}`;
        ghost.style.gridRow = `${targetRow} / span ${initialHSpan}`;

        currentBlockEl.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
        currentBlockEl.style.zIndex = "100";
        currentBlockEl.style.pointerEvents = "none";
      } else if (isResizing) {
        const deltaX = e.clientX - initialMouseX;
        const deltaY = e.clientY - initialMouseY;

        const newWidth = initialWidth + deltaX;
        const newHeight = initialHeight + deltaY;

        let targetWSpan = Math.round(newWidth / colWidth);
        targetWSpan = Math.max(1, Math.min(6 - initialCol + 1, targetWSpan));

        let targetHSpan = Math.round(newHeight / colWidth);
        targetHSpan = Math.max(1, targetHSpan);

        ghost.style.gridColumn = `${initialCol} / span ${targetWSpan}`;
        ghost.style.gridRow = `${initialRow} / span ${targetHSpan}`;
      }
    });

    document.addEventListener("mouseup", () => {
      if (!activeId || !currentBlockEl) return;

      if (isDragging) {
        currentBlockEl.classList.remove("gt-dragging");
        currentBlockEl.style.transform = "";
        currentBlockEl.style.zIndex = "";
        currentBlockEl.style.pointerEvents = "";

        const colParts = ghost.style.gridColumn.split("/");
        const rowParts = ghost.style.gridRow.split("/");

        if (colParts.length && rowParts.length) {
          const finalCol = parseInt(colParts[0]);
          const finalRow = parseInt(rowParts[0]);

          if (!isNaN(finalCol) && !isNaN(finalRow)) {
            layout[activeId!].col = finalCol;
            layout[activeId!].row = finalRow;
          }
        }
      } else if (isResizing) {
        currentBlockEl.classList.remove("gt-resizing");

        const colParts = ghost.style.gridColumn.split("span");
        const rowParts = ghost.style.gridRow.split("span");

        if (colParts.length > 1 && rowParts.length > 1) {
          const finalWSpan = parseInt(colParts[1]);
          const finalHSpan = parseInt(rowParts[1]);

          if (!isNaN(finalWSpan) && !isNaN(finalHSpan)) {
            layout[activeId!].w = finalWSpan;
            layout[activeId!].h = finalHSpan;
          }
        }
      }

      try {
        localStorage.setItem("gt-layout-grid-global-v4", JSON.stringify(layout));
        console.log("Current Layout JSON (Global):", JSON.stringify(layout));
      } catch (err) {}

      applyLayout();
      updateRowHeight();

      Object.values(chartInstances).forEach((chart: any) => chart.resize());

      ghost.style.display = "none";
      activeId = null;
      isDragging = false;
      isResizing = false;
      currentBlockEl = null;
    });
  });
</script>

