---
import Layout from '../layouts/Layout.astro';
import { fetchFgiData } from '../utils/fgi';
import { generateIndicatorData } from '../utils/sentiment';

// Helper functions for dynamic calculations
function polar(cx: number, cy: number, r: number, deg: number) {
  const rad = (deg * Math.PI) / 180;
  return { x: cx + r * Math.cos(rad), y: cy - r * Math.sin(rad) };
}

function gaugeArc(cx: number, cy: number, r: number, fromVal: number, toVal: number, scaleMin = 0, scaleMax = 100) {
  const fromPct = (fromVal - scaleMin) / (scaleMax - scaleMin);
  const toPct = (toVal - scaleMin) / (scaleMax - scaleMin);
  const fromDeg = 180 - fromPct * 180;
  const toDeg = 180 - toPct * 180;
  const p1 = polar(cx, cy, r, fromDeg);
  const p2 = polar(cx, cy, r, toDeg);
  const large = Math.abs(toPct - fromPct) > 0.5 ? 1 : 0;
  return `M ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} A ${r} ${r} 0 ${large} 0 ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
}

function fgiValueColor(v: number) {
  if (v <= 25) return '#ea3943';
  if (v <= 45) return '#f97316';
  if (v <= 55) return '#eab308';
  if (v <= 75) return '#84cc16';
  return '#16c784';
}

function fgiZhClass(v: number) {
  if (v <= 25) return '极度恐惧';
  if (v <= 45) return '恐惧';
  if (v <= 55) return '中性';
  if (v <= 75) return '贪婪';
  return '极度贪婪';
}

// 1. Fetch real FGI data (Stock, Crypto, Gold)
let fgiData = null;
let fgiError = null;
try {
  fgiData = await fetchFgiData();
} catch (e: any) {
  fgiError = e.message;
}

// 2. Fetch generated local indicators (VIX, AAII, NAAIM, PCR, DXY, US10Y)
const sentimentData = generateIndicatorData();

// Extract metrics
const cnnVal = fgiData ? fgiData.stock.currentValue : 50;
const cnnHistory = fgiData ? fgiData.stock.historicalData : [];

const btcVal = fgiData ? fgiData.crypto.currentValue : 50;
const btcHistory = fgiData ? fgiData.crypto.historicalData : [];

const goldVal = fgiData ? fgiData.gold.currentValue : 50;
const goldHistory = fgiData ? fgiData.gold.historicalData : [];

const vixVal = sentimentData.vix.currentValue;
const vixHistory = sentimentData.vix.historicalData;

const pcrVal = sentimentData.pcr.currentValue;
const pcrHistory = sentimentData.pcr.historicalData;

const dxyVal = sentimentData.dxy.currentValue;
const dxyHistory = sentimentData.dxy.historicalData;

const naaimVal = sentimentData.naaim.currentValue;
const naaimHistory = sentimentData.naaim.historicalData;

const us10yVal = sentimentData.us10y.currentValue;
const us10yHistory = sentimentData.us10y.historicalData;

const aaiiVal = sentimentData.aaii.currentValue;
const aaiiHistory = sentimentData.aaii.historicalData;

// Value mappings for specific asset states
function getVixState(v: number) {
  if (v < 15) return { text: '极度乐观', color: '#16c784' };
  if (v < 20) return { text: '正常状态', color: '#84cc16' };
  if (v < 30) return { text: '紧张情绪', color: '#eab308' };
  if (v < 40) return { text: '恐慌情绪', color: '#f97316' };
  return { text: '危机恐慌', color: '#ea3943' };
}

function getPcrState(v: number) {
  if (v < 0.7) return { text: '过度乐观', color: '#16c784' };
  if (v <= 1.0) return { text: '正常比例', color: '#84cc16' };
  if (v <= 1.2) return { text: '看跌紧张', color: '#eab308' };
  return { text: '极度恐慌', color: '#ea3943' };
}

function getNaaimState(v: number) {
  if (v < 30) return { text: '极其谨慎', color: '#ea3943' };
  if (v < 60) return { text: '防守防御', color: '#f97316' };
  if (v < 80) return { text: '中性仓位', color: '#eab308' };
  if (v < 100) return { text: '主动做多', color: '#84cc16' };
  return { text: '杠杆满仓', color: '#16c784' };
}

// SVG Gauge helper parameters
const NGCX = 100, NGCY = 92, NGR = 72;
---

<Layout>
<div class="gt-wrapper">
  <!-- 背景光晕 -->
  <div class="gt-orbs">
    <div class="gt-orb gt-orb1"></div>
    <div class="gt-orb gt-orb2"></div>
    <div class="gt-orb gt-orb3"></div>
  </div>

  <!-- 主题切换栏 -->
  <div class="gt-theme-selector">
    <button class="gt-theme-btn" data-theme-val="dark" title="深色模式">🌙</button>
    <button class="gt-theme-btn" data-theme-val="light" title="浅色模式">☀️</button>
    <button class="gt-theme-btn" data-theme-val="paper" title="护眼纸黄">📖</button>
  </div>

  <div class="gt-container">
    <!-- 标题 -->
    <div class="gt-header">
      <div class="gt-badge">🌍 全球宏观情绪与周期看板</div>
      <h1 class="gt-title">美丽与漂亮</h1>
      <p class="gt-sub">实时洞察美股、加密、流动性、机构仓位与避险情绪</p>
    </div>

    <!-- 可拖拽及自适应大小的控制台面板 (6列) -->
    <div class="gt-board">
      
      <!-- ==================== 2. VIX Volatility ==================== -->
      <div class="gt-block gt-gauge-block" data-id="vix-index">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title text-vix">VIX 恐慌指数</h2>
          <span class="gt-source">CBOE VIX</span>
        </div>
        <div class="gt-widget-body">
          <div class="gt-gauge-box">
            <svg viewBox="0 0 200 105" class="gt-gauge">
              <!-- VIX scale maps from 10 (optimism) to 50 (panic) -->
              <path d={gaugeArc(NGCX, NGCY, NGR, 10, 15, 10, 50)} stroke="#16c784" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 15, 20, 10, 50)} stroke="#84cc16" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 20, 30, 10, 50)} stroke="#eab308" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 30, 40, 10, 50)} stroke="#f97316" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 40, 50, 10, 50)} stroke="#ea3943" stroke-width="12" fill="none" opacity="0.85" />
              {(() => {
                const angleVal = Math.max(10, Math.min(50, vixVal));
                const pct = (angleVal - 10) / 40;
                return (
                  <line 
                    x1={NGCX} y1={NGCY} 
                    x2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).x.toFixed(2)} 
                    y2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).y.toFixed(2)} 
                    stroke={getVixState(vixVal).color} stroke-width="3" stroke-linecap="round" 
                  />
                );
              })()}
              <circle cx={NGCX} cy={NGCY} r="5" fill={getVixState(vixVal).color}/>
              <circle cx={NGCX} cy={NGCY} r="2.5" fill="var(--block-bg)"/>
              <text x={NGCX} y={NGCY - 14} text-anchor="middle" font-size="25" font-weight="800" fill={getVixState(vixVal).color}>{vixVal.toFixed(1)}</text>
              <text x={NGCX} y={NGCY - 1} text-anchor="middle" font-size="8.5" font-weight="700" fill="var(--text-primary)">{getVixState(vixVal).text}</text>
            </svg>
            <p class="gt-gauge-desc">标普 500 预期波动率</p>
          </div>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- ==================== 4. AAII Sentiment ==================== -->
      <div class="gt-block gt-gauge-block" data-id="aaii-index">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title text-aaii">AAII 散户调查</h2>
          <span class="gt-source">AAII Survey</span>
        </div>
        <div class="gt-widget-body">
          <div class="gt-aaii-container">
            <div class="gt-aaii-bars">
              <div class="gt-aaii-bar-item">
                <span class="aaii-lbl">看多 (Bull)</span>
                <div class="aaii-track"><div class="aaii-fill fill-bull" style={`width: ${aaiiVal.bullish}%`}></div></div>
                <span class="aaii-pct text-stock">{aaiiVal.bullish}%</span>
              </div>
              <div class="gt-aaii-bar-item">
                <span class="aaii-lbl">看空 (Bear)</span>
                <div class="aaii-track"><div class="aaii-fill fill-bear" style={`width: ${aaiiVal.bearish}%`}></div></div>
                <span class="aaii-pct text-red">{aaiiVal.bearish}%</span>
              </div>
              <div class="gt-aaii-bar-item">
                <span class="aaii-lbl">中性 (Neut)</span>
                <div class="aaii-track"><div class="aaii-fill fill-neut" style={`width: ${aaiiVal.neutral}%`}></div></div>
                <span class="aaii-pct text-gold">{aaiiVal.neutral}%</span>
              </div>
            </div>
            
            {(() => {
              const spread = aaiiVal.bullish - aaiiVal.bearish;
              const isOverheat = aaiiVal.bullish > 50;
              const isBottom = aaiiVal.bearish > 50;
              return (
                <div class="gt-aaii-verdict">
                  <p class="spread-val">多空偏离差 (Spread): <span style={`color: ${spread >= 0 ? '#16c784' : '#ea3943'}; font-weight:700`}>{spread > 0 ? `+${spread}` : spread}%</span></p>
                  {isOverheat && <div class="aaii-badge bg-danger">⚠️ 散户过度看多 (逆向见顶信号)</div>}
                  {isBottom && <div class="aaii-badge bg-success">📉 散户过度看空 (逆向见底信号)</div>}
                  {!isOverheat && !isBottom && <div class="aaii-badge bg-normal">⚖️ 情绪分化正常</div>}
                </div>
              );
            })()}
          </div>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- ==================== 5. NAAIM Exposure ==================== -->
      <div class="gt-block gt-gauge-block" data-id="naaim-index">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title text-naaim">NAAIM 机构仓位</h2>
          <span class="gt-source">NAAIM Index</span>
        </div>
        <div class="gt-widget-body">
          <div class="gt-gauge-box">
            <svg viewBox="0 0 200 105" class="gt-gauge">
              <!-- Scale from 0 to 120 (since managers can leverage) -->
              <path d={gaugeArc(NGCX, NGCY, NGR, 0, 30, 0, 120)} stroke="#ea3943" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 30, 60, 0, 120)} stroke="#f97316" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 60, 80, 0, 120)} stroke="#eab308" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 80, 100, 0, 120)} stroke="#84cc16" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 100, 120, 0, 120)} stroke="#16c784" stroke-width="12" fill="none" opacity="0.85" />
              {(() => {
                const angleVal = Math.max(0, Math.min(120, naaimVal));
                const pct = angleVal / 120;
                return (
                  <line 
                    x1={NGCX} y1={NGCY} 
                    x2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).x.toFixed(2)} 
                    y2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).y.toFixed(2)} 
                    stroke={getNaaimState(naaimVal).color} stroke-width="3" stroke-linecap="round" 
                  />
                );
              })()}
              <circle cx={NGCX} cy={NGCY} r="5" fill={getNaaimState(naaimVal).color}/>
              <circle cx={NGCX} cy={NGCY} r="2.5" fill="var(--block-bg)"/>
              <text x={NGCX} y={NGCY - 14} text-anchor="middle" font-size="25" font-weight="800" fill={getNaaimState(naaimVal).color}>{Math.round(naaimVal)}%</text>
              <text x={NGCX} y={NGCY - 1} text-anchor="middle" font-size="8.5" font-weight="700" fill="var(--text-primary)">{getNaaimState(naaimVal).text}</text>
            </svg>
            <p class="gt-gauge-desc">主动型基金经理权益类仓位</p>
          </div>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- ==================== 6. Put/Call Ratio ==================== -->
      <div class="gt-block gt-gauge-block" data-id="pcr-index">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title text-pcr">Put/Call 期权比</h2>
          <span class="gt-source">PCR Ratio</span>
        </div>
        <div class="gt-widget-body">
          <div class="gt-gauge-box">
            <svg viewBox="0 0 200 105" class="gt-gauge">
              <!-- Scale from 0.4 (optimistic) to 1.4 (fear) -->
              <path d={gaugeArc(NGCX, NGCY, NGR, 0.4, 0.7, 0.4, 1.4)} stroke="#16c784" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 0.7, 1.0, 0.4, 1.4)} stroke="#84cc16" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 1.0, 1.2, 0.4, 1.4)} stroke="#eab308" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 1.2, 1.4, 0.4, 1.4)} stroke="#ea3943" stroke-width="12" fill="none" opacity="0.85" />
              {(() => {
                const angleVal = Math.max(0.4, Math.min(1.4, pcrVal));
                const pct = (angleVal - 0.4) / 1.0;
                return (
                  <line 
                    x1={NGCX} y1={NGCY} 
                    x2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).x.toFixed(2)} 
                    y2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).y.toFixed(2)} 
                    stroke={getPcrState(pcrVal).color} stroke-width="3" stroke-linecap="round" 
                  />
                );
              })()}
              <circle cx={NGCX} cy={NGCY} r="5" fill={getPcrState(pcrVal).color}/>
              <circle cx={NGCX} cy={NGCY} r="2.5" fill="var(--block-bg)"/>
              <text x={NGCX} y={NGCY - 14} text-anchor="middle" font-size="25" font-weight="800" fill={getPcrState(pcrVal).color}>{pcrVal.toFixed(2)}</text>
              <text x={NGCX} y={NGCY - 1} text-anchor="middle" font-size="8.5" font-weight="700" fill="var(--text-primary)">{getPcrState(pcrVal).text}</text>
            </svg>
            <p class="gt-gauge-desc">看跌与看涨期权持仓量之比</p>
          </div>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- ==================== 7. DXY Dollar Index ==================== -->
      <div class="gt-block gt-gauge-block" data-id="dxy-index">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title text-dxy">美元指数 (DXY)</h2>
          <span class="gt-source">US Dollar</span>
        </div>
        <div class="gt-widget-body">
          <div class="gt-gauge-box">
            <svg viewBox="0 0 200 105" class="gt-gauge">
              <!-- Scale from 96 to 110 -->
              <path d={gaugeArc(NGCX, NGCY, NGR, 96, 99, 96, 110)} stroke="#16c784" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 99, 103, 96, 110)} stroke="#84cc16" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 103, 106, 96, 110)} stroke="#eab308" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 106, 110, 96, 110)} stroke="#ea3943" stroke-width="12" fill="none" opacity="0.85" />
              {(() => {
                const angleVal = Math.max(96, Math.min(110, dxyVal));
                const pct = (angleVal - 96) / 14;
                const activeColor = dxyVal < 100 ? '#16c784' : dxyVal < 103 ? '#84cc16' : dxyVal < 106 ? '#eab308' : '#ea3943';
                return (
                  <>
                    <line 
                      x1={NGCX} y1={NGCY} 
                      x2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).x.toFixed(2)} 
                      y2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).y.toFixed(2)} 
                      stroke={activeColor} stroke-width="3" stroke-linecap="round" 
                    />
                    <circle cx={NGCX} cy={NGCY} r="5" fill={activeColor}/>
                  </>
                );
              })()}
              <circle cx={NGCX} cy={NGCY} r="2.5" fill="var(--block-bg)"/>
              <text x={NGCX} y={NGCY - 14} text-anchor="middle" font-size="25" font-weight="800" fill={dxyVal < 103 ? '#16c784' : '#ea3943'}>{dxyVal.toFixed(2)}</text>
              <text x={NGCX} y={NGCY - 1} text-anchor="middle" font-size="8.5" font-weight="700" fill="var(--text-primary)">{dxyVal < 100 ? '资金流出 / 风险偏好高' : dxyVal < 103 ? '汇率正常' : '避险资金回流 / 流动性收紧'}</text>
            </svg>
            <p class="gt-gauge-desc">美元兑六种主要货币的汇率</p>
          </div>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- ==================== 8. US10Y Yield ==================== -->
      <div class="gt-block gt-gauge-block" data-id="us10y-index">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title text-rate">美债10Y收益率</h2>
          <span class="gt-source">US10Y Yield</span>
        </div>
        <div class="gt-widget-body">
          <div class="gt-gauge-box">
            <svg viewBox="0 0 200 105" class="gt-gauge">
              <!-- Scale from 2.8% to 5.2% -->
              <path d={gaugeArc(NGCX, NGCY, NGR, 2.8, 3.5, 2.8, 5.2)} stroke="#16c784" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 3.5, 4.2, 2.8, 5.2)} stroke="#84cc16" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 4.2, 4.7, 2.8, 5.2)} stroke="#eab308" stroke-width="12" fill="none" opacity="0.85" />
              <path d={gaugeArc(NGCX, NGCY, NGR, 4.7, 5.2, 2.8, 5.2)} stroke="#ea3943" stroke-width="12" fill="none" opacity="0.85" />
              {(() => {
                const angleVal = Math.max(2.8, Math.min(5.2, us10yVal));
                const pct = (angleVal - 2.8) / 2.4;
                const activeColor = us10yVal < 3.5 ? '#16c784' : us10yVal < 4.2 ? '#84cc16' : us10yVal < 4.7 ? '#eab308' : '#ea3943';
                return (
                  <>
                    <line 
                      x1={NGCX} y1={NGCY} 
                      x2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).x.toFixed(2)} 
                      y2={polar(NGCX, NGCY, NGR - 8, 180 - pct * 180).y.toFixed(2)} 
                      stroke={activeColor} stroke-width="3" stroke-linecap="round" 
                    />
                    <circle cx={NGCX} cy={NGCY} r="5" fill={activeColor}/>
                  </>
                );
              })()}
              <circle cx={NGCX} cy={NGCY} r="2.5" fill="var(--block-bg)"/>
              <text x={NGCX} y={NGCY - 14} text-anchor="middle" font-size="25" font-weight="800" fill={us10yVal < 4.2 ? '#16c784' : '#ea3943'}>{us10yVal.toFixed(3)}%</text>
