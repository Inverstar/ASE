                      y={GCY - 16}
                      text-anchor="middle"
                      font-size="26"
                      font-weight="800"
                      fill={needleColor}
                    >
                      {latest?.value}
                    </text>
                    <text
                      x={GCX}
                      y={GCY - 3}
                      text-anchor="middle"
                      font-size="7"
                      fill="var(--text-secondary)"
                      letter-spacing="0.8"
                    >
                      {zhClass(latest?.value_classification)}
                    </text>
                    <text
                      x="14"
                      y={GCY + 14}
                      font-size="6.5"
                      fill="var(--text-secondary)"
                      opacity="0.6"
                      text-anchor="middle"
                    >
                      0
                    </text>
                    <text
                      x={GCX}
                      y="10"
                      font-size="6.5"
                      fill="var(--text-secondary)"
