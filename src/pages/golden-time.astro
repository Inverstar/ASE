          <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
        </div>

        <!-- ==================== BLOCK 2: CMC 仪表盘 ==================== -->
        <div class="gt-block gt-cmc-gauge" data-id="cmc-gauge">
          <div class="gt-panel-head">
            <div class="gt-drag-handle" title="按住拖拽调整位置">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="currentColor"
