              >
                <circle cx="9" cy="5" r="2"></circle><circle
                  cx="9"
                  cy="12"
                  r="2"></circle><circle cx="9" cy="19" r="2"></circle>
                <circle cx="15" cy="5" r="2"></circle><circle
                  cx="15"
                  cy="12"
                  r="2"></circle><circle cx="15" cy="19" r="2"></circle>
              </svg>
