                              offset="0%"
                              stop-color="#f59e0b"
                              stop-opacity="0.3"
                            />
                            <stop
                              offset="100%"
                              stop-color="#f59e0b"
                              stop-opacity="0"
                            />
                          </linearGradient>
                        </defs>
                        {zones
                          .slice()
                          .reverse()
                          .map((z) => {
                            const y1 =
                              CPT + ((100 - z.to) / 100) * (CH - CPT * 2);
                            const y2 =
                              CPT + ((100 - z.from) / 100) * (CH - CPT * 2);
                            return (
                              <rect
                                x="0"
                                y={y1.toFixed(1)}
                                width={CW}
                                height={(y2 - y1).toFixed(1)}
                                fill={z.color}
                                opacity="0.05"
                              />
                            );
                          })}
                        {[20, 40, 60, 80].map((v) => {
                          const gy = CPT + ((100 - v) / 100) * (CH - CPT * 2);
                          return (
                            <line
                              x1="0"
                              y1={gy.toFixed(1)}
                              x2={CW}
                              y2={gy.toFixed(1)}
                              stroke="var(--chart-grid-line)"
                              stroke-width="1"
                              stroke-dasharray="3 4"
                            />
                          );
                        })}
                        {area && (
                          <polygon points={area} fill="url(#areaGrad)" />
                        )}
                        {polyline && (
                          <polyline
                            points={polyline}
                            fill="none"
                            stroke="#f59e0b"
                            stroke-width="1.8"
                            stroke-linejoin="round"
                            stroke-linecap="round"
                          />
                        )}
                        {chartPts.length > 0 && (
                          <circle
                            cx={chartPts[chartPts.length - 1].x}
                            cy={chartPts[chartPts.length - 1].y}
                            r="3.5"
                            fill={needleColor}
                            stroke="#06060f"
                            stroke-width="1.5"
                          />
                        )}
                      </svg>
                      <div class="gt-y-axis">
                        <>
                          <span>100</span>
                          <span>80</span>
                          <span>60</span>
                          <span>40</span>
                          <span>20</span>
                          <span>0</span>
                        </>
                      </div>
                      {chartRaw.length > 0 && (
                        <div class="gt-x-axis">
                          <span>{fmtDate(chartRaw[0].timestamp)}</span>
                          <span>
                            {fmtDate(
                              chartRaw[Math.floor(chartRaw.length / 2)]
                                .timestamp,
                            )}
                          </span>
                          <span>
                            {fmtDate(chartRaw[chartRaw.length - 1].timestamp)}
                          </span>
                        </div>
                      )}
                    </div>

                    <div class="gt-legend">
                      {zones.map((z) => (
                        <div class="gt-legend-item">
                          <span
                            class="gt-legend-dot"
                            style={`background:${z.color}`}
                          />
                          <span class="gt-legend-label">{z.label}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )
              }
            </a>

