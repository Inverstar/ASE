                      50
                    </text>
                    <text
                      x="186"
                      y={GCY + 14}
                      font-size="6.5"
                      fill="var(--text-secondary)"
                      opacity="0.6"
                      text-anchor="middle"
                    >
                      100
                    </text>
                  </svg>

                  <div class="gt-pills">
                    {[
                      { label: "昨天", data: yesterday },
                      { label: "上周", data: lastWeek },
                      { label: "上月", data: lastMonth },
                    ].map(({ label, data }) => (
                      <div class="gt-pill">
                        <span class="gt-pill-label">{label}</span>
                        <span
                          class="gt-pill-val"
                          style={data ? `color:${valueColor(data.value)}` : ""}
                        >
                          {data
                            ? `${zhClass(data.value_classification)} · ${data.value}`
                            : "—"}
                        </span>
                      </div>
                    ))}
                  </div>

                  {(yearHigh || yearLow) && (
                    <div class="gt-year">
                      {yearHigh && (
                        <div class="gt-year-block">
                          <div class="gt-year-title">
                            🏆 年度高点{" "}
                            <span
                              style={`color:${valueColor(yearHigh.value)};font-weight:700`}
                            >
                              {zhClass(yearHigh.value_classification)}{" "}
                              {yearHigh.value}
                            </span>
                          </div>
                          <div class="gt-year-d">
                            {fmtDate(yearHigh.timestamp)}
                          </div>
                        </div>
                      )}
                      {yearLow && (
                        <div class="gt-year-block">
                          <div class="gt-year-title">
                            📉 年度低点{" "}
                            <span
                              style={`color:${valueColor(yearLow.value)};font-weight:700`}
                            >
                              {zhClass(yearLow.value_classification)}{" "}
                              {yearLow.value}
                            </span>
                          </div>
                          <div class="gt-year-d">
