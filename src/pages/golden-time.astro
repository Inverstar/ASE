                    class="gt-chart-wrap-container"
                    id="gt-chart-container"
                    data-cmc={JSON.stringify(cmcData)}
                    style="border:none; margin:0; padding:0;"
                  >
                    <div class="gt-chart-header">
                      <p class="gt-chart-label">过去 30 天趋势</p>
                      <div class="gt-chart-tabs">
                        <button class="gt-tab-btn active" data-range="30">
                          30天
                        </button>
                        <button class="gt-tab-btn" data-range="365">
                          1年
                        </button>
                        <button class="gt-tab-btn" data-range="1095">
                          3年
                        </button>
                        <button class="gt-tab-btn" data-range="1825">
                          5年
                        </button>
                      </div>
                    </div>
                    <div class="gt-chart-wrap">
                      <svg
                        viewBox={`0 0 ${CW} ${CH}`}
                        class="gt-line-chart"
                        preserveAspectRatio="none"
                      >
                        <defs>
                          <linearGradient
                            id="areaGrad"
                            x1="0"
                            y1="0"
                            x2="0"
                            y2="1"
