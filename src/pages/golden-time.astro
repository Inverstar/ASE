---
import Layout from "../layouts/Layout.astro";
import { fetchFgiData } from "../utils/fgi";

// Utility helper functions
function polar(cx: number, cy: number, r: number, deg: number) {
  const rad = (deg * Math.PI) / 180;
  return { x: cx + r * Math.cos(rad), y: cy - r * Math.sin(rad) };
}

function gaugeArc(
  cx: number,
  cy: number,
  r: number,
  fromVal: number,
  toVal: number,
) {
  const fromDeg = 180 - fromVal * 1.8;
  const toDeg = 180 - toVal * 1.8;
  const p1 = polar(cx, cy, r, fromDeg);
  const p2 = polar(cx, cy, r, toDeg);
  const large = Math.abs(toVal - fromVal) > 50 ? 1 : 0;
  return `M ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} A ${r} ${r} 0 ${large} 0 ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
}

function valueColor(v: number) {
  if (v <= 20) return "#ea3943";
  if (v <= 40) return "#f97316";
  if (v <= 60) return "#eab308";
  if (v <= 80) return "#84cc16";
  return "#16c784";
}

function zhClass(cls: string) {
  const s = (cls || "").toLowerCase();
  if (s === "extreme fear") return "极度恐惧";
  if (s === "fear") return "恐惧";
  if (s === "neutral") return "中性";
  if (s === "greed") return "贪婪";
  if (s === "extreme greed") return "极度贪婪";
  return cls;
}

// Custom parser to map number FGI back to Chinese class
function numberFgiZhClass(v: number) {
  if (v <= 25) return "极度恐惧";
  if (v <= 45) return "恐惧";
  if (v <= 55) return "中性";
  if (v <= 75) return "贪婪";
  return "极度贪婪";
}

function fmtDate(ts: any) {
  const ms = Number(ts) < 1e12 ? Number(ts) * 1000 : Number(ts);
  return new Date(ms).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

// 1. Fetch original CMC data if API Key is available
const CMC_KEY = import.meta.env.CMC_API_KEY;
let cmcData = null;
let cmcError = null;

if (CMC_KEY) {
  try {
    const fetchPage = async (limit: number, start = 1) => {
      const url = `https://pro-api.coinmarketcap.com/v3/fear-and-greed/historical?limit=${limit}${start > 1 ? `&start=${start}` : ""}`;
      const res = await fetch(url, {
        headers: { "X-CMC_PRO_API_KEY": CMC_KEY, Accept: "application/json" },
      });
      return res.json();
    };

    const fetchLatest = async () => {
      const url = "https://pro-api.coinmarketcap.com/v3/fear-and-greed/latest";
      const res = await fetch(url, {
        headers: { "X-CMC_PRO_API_KEY": CMC_KEY, Accept: "application/json" },
      });
      return res.json();
    };

    const [latestRes, p1, p2, p3] = await Promise.all([
      fetchLatest(),
      fetchPage(500, 1),
      fetchPage(500, 501),
      fetchPage(500, 1001),
    ]);

    const allData = [];
    if (Array.isArray(p1?.data)) allData.push(...p1.data);
    if (Array.isArray(p2?.data)) allData.push(...p2.data);
    if (Array.isArray(p3?.data)) allData.push(...p3.data);

    if (allData.length > 0) {
      cmcData = allData;

      const latestItem = latestRes?.data ?? null;
      if (latestItem && cmcData.length > 0) {
        const latestTs = Math.floor(
          new Date(latestItem.update_time).getTime() / 1000,
        );
        const latestDateStr = new Date(latestTs * 1000)
          .toISOString()
          .split("T")[0];
        const firstHistDateStr = new Date(Number(cmcData[0].timestamp) * 1000)
          .toISOString()
          .split("T")[0];

        if (
          latestDateStr !== firstHistDateStr &&
          latestTs > Number(cmcData[0].timestamp)
        ) {
          cmcData.unshift({
            timestamp: String(latestTs),
            value: latestItem.value,
            value_classification: latestItem.value_classification,
          });
        } else {
          cmcData[0] = {
            timestamp: cmcData[0].timestamp,
            value: latestItem.value,
            value_classification: latestItem.value_classification,
          };
        }
      }
    } else {
      cmcError =
        p1?.status?.error_message ??
        p2?.status?.error_message ??
        p3?.status?.error_message ??
        "API 返回数据异常";
    }
  } catch (e: any) {
    cmcError = e.message;
  }
} else {
  cmcError = "NO_KEY";
}

const latest = cmcData?.[0] ?? null;
const yesterday = cmcData?.[1] ?? null;
const lastWeek = cmcData?.[7] ?? null;
const lastMonth = cmcData?.[30] ?? null;

let yearHigh = null,
  yearLow = null;
if (cmcData) {
  const yearlyData = cmcData.slice(0, 365);
  for (const d of yearlyData) {
    if (!yearHigh || d.value > yearHigh.value) yearHigh = d;
    if (!yearLow || d.value < yearLow.value) yearLow = d;
  }
}

const chartRaw = cmcData ? [...cmcData.slice(0, 30)].reverse() : [];
const CW = 560,
  CH = 100,
  CPT = 6;
const chartPts = chartRaw.map((d, i) => {
  const x = chartRaw.length > 1 ? (i / (chartRaw.length - 1)) * CW : CW / 2;
  const y = CPT + ((100 - d.value) / 100) * (CH - CPT * 2);
  return { x: +x.toFixed(2), y: +y.toFixed(2), v: d.value };
});
const polyline = chartPts.map((p) => `${p.x},${p.y}`).join(" ");
const area = chartPts.length ? `0,${CH} ${polyline} ${CW},${CH}` : "";

const GCX = 100,
  GCY = 95,
  GR = 74;
const zones = [
  { from: 0, to: 20, color: "#ea3943", label: "极度恐惧" },
  { from: 20, to: 40, color: "#f97316", label: "恐惧" },
  { from: 40, to: 60, color: "#eab308", label: "中性" },
  { from: 60, to: 80, color: "#84cc16", label: "贪婪" },
  { from: 80, to: 100, color: "#16c784", label: "极度贪婪" },
];
const needleDeg = latest ? 180 - latest.value * 1.8 : 90;
const needleTip = polar(GCX, GCY, GR - 8, needleDeg);
const needleColor = latest ? valueColor(latest.value) : "#94a3b8";

// 2. Fetch new FGI data (Stock, Crypto, Gold) from feargreedindex.org
let fgiData = null;
let fgiError = null;

try {
  fgiData = await fetchFgiData();
} catch (e: any) {
  fgiError = e.message;
}

// Function to extract metrics for new FGI components
function getAssetMetrics(hist: any[]) {
  if (!hist || hist.length === 0) return null;
  const latestVal = hist[hist.length - 1];
  const yesterdayVal = hist[hist.length - 2] || null;
  const lastWeekVal = hist[hist.length - 8] || null;
  const lastMonthVal = hist[hist.length - 31] || null;
  const lastQuarterVal = hist[hist.length - 91] || null;
  const lastHalfYearVal = hist[hist.length - 181] || null;
  const lastYearVal = hist[hist.length - 366] || null;

  const yearlySlice = hist.slice(-365);
  let yHigh = null;
  let yLow = null;
  for (const d of yearlySlice) {
    if (!yHigh || d.value > yHigh.value) yHigh = d;
    if (!yLow || d.value < yLow.value) yLow = d;
  }

  return {
    latest: latestVal,
    yesterday: yesterdayVal,
    lastWeek: lastWeekVal,
    lastMonth: lastMonthVal,
    lastQuarter: lastQuarterVal,
    lastHalfYear: lastHalfYearVal,
    lastYear: lastYearVal,
    yearHigh: yHigh,
    yearLow: yLow,
  };
}

const cryptoMetrics = fgiData
  ? getAssetMetrics(fgiData.crypto.historicalData)
  : null;
const goldMetrics = fgiData
  ? getAssetMetrics(fgiData.gold.historicalData)
  : null;
const stockMetrics = fgiData
  ? getAssetMetrics(fgiData.stock.historicalData)
  : null;

// SVG constants for circular gauges
const NGCX = 100,
  NGCY = 92,
  NGR = 72;
const nzones = [
  { from: 0, to: 25, color: "#ea3943", label: "极度恐惧" },
  { from: 25, to: 45, color: "#f97316", label: "恐惧" },
  { from: 45, to: 55, color: "#eab308", label: "中性" },
  { from: 55, to: 75, color: "#84cc16", label: "贪婪" },
  { from: 75, to: 100, color: "#16c784", label: "极度贪婪" },
];
---

<Layout>
