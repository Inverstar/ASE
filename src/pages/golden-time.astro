---
import Layout from '../layouts/Layout.astro';

function polar(cx, cy, r, deg) {
  const rad = (deg * Math.PI) / 180;
  return { x: cx + r * Math.cos(rad), y: cy - r * Math.sin(rad) };
}

function gaugeArc(cx, cy, r, fromVal, toVal) {
  const fromDeg = 180 - fromVal * 1.8;
  const toDeg   = 180 - toVal   * 1.8;
  const p1 = polar(cx, cy, r, fromDeg);
  const p2 = polar(cx, cy, r, toDeg);
  const large = Math.abs(toVal - fromVal) > 50 ? 1 : 0;
  return `M ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} A ${r} ${r} 0 ${large} 0 ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
}

function valueColor(v) {
  if (v <= 20) return '#ea3943';
  if (v <= 40) return '#f97316';
  if (v <= 60) return '#eab308';
  if (v <= 80) return '#84cc16';
  return '#16c784';
}

function zhClass(cls) {
  const s = (cls || '').toLowerCase();
  if (s === 'extreme fear')  return '极度恐惧';
  if (s === 'fear')          return '恐惧';
  if (s === 'neutral')       return '中性';
  if (s === 'greed')         return '贪婪';
  if (s === 'extreme greed') return '极度贪婪';
  return cls;
}

function fmtDate(ts) {
  const ms = Number(ts) < 1e12 ? Number(ts) * 1000 : Number(ts);
  return new Date(ms).toLocaleDateString('zh-CN', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}

const CMC_KEY = import.meta.env.CMC_API_KEY;
let cmcData = null;
let cmcError = null;

if (CMC_KEY) {
  try {
    const res = await fetch(
      'https://pro-api.coinmarketcap.com/v3/fear-and-greed/historical?limit=365',
      { headers: { 'X-CMC_PRO_API_KEY': CMC_KEY, Accept: 'application/json' } }
    );
    const json = await res.json();
    if (Array.isArray(json?.data)) {
      cmcData = json.data;
    } else {
      cmcError = json?.status?.error_message ?? 'API 返回数据异常';
    }
  } catch (e) {
    cmcError = e.message;
  }
} else {
  cmcError = 'NO_KEY';
}

const latest    = cmcData?.[0]  ?? null;
const yesterday = cmcData?.[1]  ?? null;
const lastWeek  = cmcData?.[7]  ?? null;
const lastMonth = cmcData?.[30] ?? null;

let yearHigh = null, yearLow = null;
if (cmcData) {
  for (const d of cmcData) {
    if (!yearHigh || d.value > yearHigh.value) yearHigh = d;
    if (!yearLow  || d.value < yearLow.value)  yearLow  = d;
  }
}

const chartRaw = cmcData ? [...cmcData.slice(0, 30)].reverse() : [];
const CW = 560, CH = 100, CPT = 6;
const chartPts = chartRaw.map((d, i) => {
  const x = chartRaw.length > 1 ? (i / (chartRaw.length - 1)) * CW : CW / 2;
  const y = CPT + ((100 - d.value) / 100) * (CH - CPT * 2);
  return { x: +x.toFixed(2), y: +y.toFixed(2), v: d.value };
});
const polyline = chartPts.map(p => `${p.x},${p.y}`).join(' ');
const area = chartPts.length ? `0,${CH} ${polyline} ${CW},${CH}` : '';

const GCX = 100, GCY = 95, GR = 74;
const zones = [
  { from:  0, to: 20, color: '#ea3943', label: '极度恐惧' },
  { from: 20, to: 40, color: '#f97316', label: '恐惧' },
  { from: 40, to: 60, color: '#eab308', label: '中性' },
  { from: 60, to: 80, color: '#84cc16', label: '贪婪' },
  { from: 80, to:100, color: '#16c784', label: '极度贪婪' },
];
const needleDeg   = latest ? 180 - latest.value * 1.8 : 90;
const needleTip   = polar(GCX, GCY, GR - 8, needleDeg);
const needleColor = latest ? valueColor(latest.value) : '#94a3b8';
---

<Layout>
<div class="gt-wrapper">
  <!-- 背景光晕 -->
  <div class="gt-orbs">
    <div class="gt-orb gt-orb1"></div>
    <div class="gt-orb gt-orb2"></div>
    <div class="gt-orb gt-orb3"></div>
  </div>

  <!-- 主题切换栏 -->
  <div class="gt-theme-selector">
    <button class="gt-theme-btn" data-theme-val="dark" title="深色模式">🌙</button>
    <button class="gt-theme-btn" data-theme-val="light" title="浅色模式">☀️</button>
    <button class="gt-theme-btn" data-theme-val="paper" title="护眼纸黄">📖</button>
  </div>

  <div class="gt-container">

    <!-- 标题 -->
    <div class="gt-header">
      <div class="gt-badge">📈 市场情绪</div>
      <h1 class="gt-title">金时纪</h1>
      <p class="gt-sub">洞察加密市场的贪婪与恐惧</p>
    </div>

    <!-- 💡 可拖拽及自适应大小的控制台面板 (九宫格正方形) 💡 -->
    <div class="gt-board">
      
      <!-- Block 1: Alternative.me 指数 -->
      <div class="gt-block gt-altme" data-id="altme">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/>
              <circle cx="9" cy="12" r="2"/>
              <circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/>
              <circle cx="15" cy="12" r="2"/>
              <circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title">Crypto Fear &amp; Greed</h2>
          <span class="gt-source">alternative.me</span>
        </div>
        <a
          href="https://alternative.me/crypto/fear-and-greed-index/"
          target="_blank"
          rel="noopener noreferrer"
          class="gt-img-link"
        >
          <div class="gt-img-wrap">
            <img
              src="https://alternative.me/crypto/fear-and-greed-index.png"
              alt="Crypto Fear & Greed Index"
              class="gt-img"
              loading="lazy"
            />
            <div class="gt-img-ov">
              <span class="gt-ov-icon">🔗</span>
              <span class="gt-ov-text">查看详情</span>
            </div>
          </div>
        </a>
        <p class="gt-hint">每日自动更新</p>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- Block 2: CMC 仪表盘 -->
      <div class="gt-block gt-cmc-gauge" data-id="cmc-gauge">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/>
              <circle cx="9" cy="12" r="2"/>
              <circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/>
              <circle cx="15" cy="12" r="2"/>
              <circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title gt-cmc-title">
            <a href="https://coinmarketcap.com/charts/fear-and-greed-index/" target="_blank" rel="noopener noreferrer">CMC Gauge</a>
          </h2>
          <span class="gt-cmc-badge">CMC</span>
        </div>

        <a
          href="https://coinmarketcap.com/charts/fear-and-greed-index/"
          target="_blank"
          rel="noopener noreferrer"
          class="gt-cmc-body-link"
        >
          {cmcError ? (
            <div class="gt-placeholder">
              {cmcError === 'NO_KEY' ? (
                <div class="gt-ph-inner">
                  <div class="gt-ph-icon">🔑</div>
                  <p class="gt-ph-title">需要配置 API Key</p>
                  <p class="gt-ph-desc">请设置环境变量 <code>CMC_API_KEY</code></p>
                </div>
              ) : (
                <div class="gt-ph-inner">
                  <div class="gt-ph-icon">⚠️</div>
                  <p class="gt-ph-title">数据加载失败</p>
                  <p class="gt-ph-desc">{cmcError}</p>
                </div>
              )}
            </div>
          ) : (
            <div class="gt-gauge-wrap">
              <svg viewBox="0 0 200 105" class="gt-gauge" aria-label={`当前指数: ${latest?.value}`}>
                {zones.map(z => (
                  <path
                    d={gaugeArc(GCX, GCY, GR, z.from, z.to)}
                    stroke={z.color}
                    stroke-width="13"
                    fill="none"
                    stroke-linecap="butt"
                    opacity="0.9"
                  />
                ))}
                <path d={gaugeArc(GCX, GCY, GR - 22, 0, 100)} stroke="rgba(255,255,255,0.05)" stroke-width="1" fill="none"/>
                <line x1={GCX} y1={GCY} x2={needleTip.x.toFixed(2)} y2={needleTip.y.toFixed(2)} stroke={needleColor} stroke-width="2.5" stroke-linecap="round"/>
                <circle cx={GCX} cy={GCY} r="5.5" fill={needleColor}/>
                <circle cx={GCX} cy={GCY} r="2.5" fill="var(--block-bg)"/>
                <text x={GCX} y={GCY - 16} text-anchor="middle" font-size="26" font-weight="800" fill={needleColor}>{latest?.value}</text>
                <text x={GCX} y={GCY - 3} text-anchor="middle" font-size="7" fill="var(--text-secondary)" letter-spacing="0.8">{zhClass(latest?.value_classification)}</text>
                <text x="14"  y={GCY + 14} font-size="6.5" fill="var(--text-secondary)" opacity="0.6" text-anchor="middle">0</text>
                <text x={GCX} y="10"       font-size="6.5" fill="var(--text-secondary)" opacity="0.6" text-anchor="middle">50</text>
                <text x="186" y={GCY + 14} font-size="6.5" fill="var(--text-secondary)" opacity="0.6" text-anchor="middle">100</text>
              </svg>

              <div class="gt-pills">
                {[
                  { label: '昨天', data: yesterday },
                  { label: '上周', data: lastWeek  },
                  { label: '上月', data: lastMonth },
                ].map(({ label, data }) => (
                  <div class="gt-pill">
                    <span class="gt-pill-label">{label}</span>
                    <span class="gt-pill-val" style={data ? `color:${valueColor(data.value)}` : ''}>
                      {data ? `${zhClass(data.value_classification)} · ${data.value}` : '—'}
                    </span>
                  </div>
                ))}
              </div>

              {(yearHigh || yearLow) && (
                <div class="gt-year">
                  {yearHigh && (
                    <div class="gt-year-block">
                      <div class="gt-year-title">
                        🏆 年度高点 <span style={`color:${valueColor(yearHigh.value)};font-weight:700`}>{zhClass(yearHigh.value_classification)} {yearHigh.value}</span>
                      </div>
                      <div class="gt-year-d">{fmtDate(yearHigh.timestamp)}</div>
                    </div>
                  )}
                  {yearLow && (
                    <div class="gt-year-block">
                      <div class="gt-year-title">
                        📉 年度低点 <span style={`color:${valueColor(yearLow.value)};font-weight:700`}>{zhClass(yearLow.value_classification)} {yearLow.value}</span>
                      </div>
                      <div class="gt-year-d">{fmtDate(yearLow.timestamp)}</div>
                    </div>
                  )}
                </div>
              )}
            </div>
          )}
        </a>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- Block 3: CMC 趋势图 + 情绪区间说明 (已合并为单个组件) -->
      <div class="gt-block gt-cmc-chart" data-id="cmc-chart">
        <div class="gt-panel-head" style="padding-bottom: 0.5rem;">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/>
              <circle cx="9" cy="12" r="2"/>
              <circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/>
              <circle cx="15" cy="12" r="2"/>
              <circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title gt-cmc-title">
            <a href="https://coinmarketcap.com/charts/fear-and-greed-index/" target="_blank" rel="noopener noreferrer">CMC Trend &amp; Ranges</a>
          </h2>
          <span class="gt-cmc-badge">CMC</span>
        </div>

        <div class="gt-chart-info-combined">
          <!-- 上部分：折线趋势图 -->
          <a
            href="https://coinmarketcap.com/charts/fear-and-greed-index/"
            target="_blank"
            rel="noopener noreferrer"
            class="gt-cmc-body-link"
            style="border-bottom: 1px solid var(--border-color); padding: 0.8rem 1.5rem 1rem 1.5rem;"
          >
            {cmcError ? (
              <div class="gt-placeholder">
                <div class="gt-ph-inner">
                  <p class="gt-ph-title">数据不可用</p>
                </div>
              </div>
            ) : (
              <div class="gt-chart-wrap-container" style="border:none; margin:0; padding:0;">
                <p class="gt-chart-label">过去 30 天趋势</p>
                <div class="gt-chart-wrap">
                  <svg viewBox={`0 0 ${CW} ${CH}`} class="gt-line-chart" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%"   stop-color="#f59e0b" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    {zones.slice().reverse().map(z => {
                      const y1 = CPT + ((100 - z.to)   / 100) * (CH - CPT * 2);
                      const y2 = CPT + ((100 - z.from) / 100) * (CH - CPT * 2);
                      return <rect x="0" y={y1.toFixed(1)} width={CW} height={(y2-y1).toFixed(1)} fill={z.color} opacity="0.05"/>;
                    })}
                    {[20,40,60,80].map(v => {
                      const gy = CPT + ((100-v)/100)*(CH-CPT*2);
                      return <line x1="0" y1={gy.toFixed(1)} x2={CW} y2={gy.toFixed(1)} stroke="var(--chart-grid-line)" stroke-width="1" stroke-dasharray="3 4"/>;
                    })}
                    {area && <polygon points={area} fill="url(#areaGrad)"/>}
                    {polyline && <polyline points={polyline} fill="none" stroke="#f59e0b" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>}
                    {chartPts.length > 0 && (
                      <circle
                        cx={chartPts[chartPts.length-1].x}
                        cy={chartPts[chartPts.length-1].y}
                        r="3.5" fill={needleColor} stroke="#06060f" stroke-width="1.5"
                      />
                    )}
                  </svg>
                  <div class="gt-y-axis">
                    <span>100</span><span>80</span><span>60</span><span>40</span><span>20</span><span>0</span>
                  </div>
                  {chartRaw.length > 0 && (
                    <div class="gt-x-axis">
                      <span>{fmtDate(chartRaw[0].timestamp)}</span>
                      <span>{fmtDate(chartRaw[Math.floor(chartRaw.length/2)].timestamp)}</span>
                      <span>{fmtDate(chartRaw[chartRaw.length-1].timestamp)}</span>
                    </div>
                  )}
                </div>

                <div class="gt-legend">
                  {zones.map(z => (
                    <div class="gt-legend-item">
                      <span class="gt-legend-dot" style={`background:${z.color}`}></span>
                      <span class="gt-legend-label">{z.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </a>

          <!-- 下部分：情绪区间说明 -->
          <div class="gt-info">
            {[
              { icon: '😱', label: '极度恐惧', range: '0–20',   desc: '买入机会',  color: '#ea3943' },
              { icon: '😨', label: '恐惧',     range: '21–40',  desc: '情绪谨慎',  color: '#f97316' },
              { icon: '😐', label: '中性',     range: '41–60',  desc: '情绪平稳',  color: '#eab308' },
              { icon: '😊', label: '贪婪',     range: '61–80',  desc: '注意风险',  color: '#84cc16' },
              { icon: '🤑', label: '极度贪婪', range: '81–100', desc: '卖出信号',  color: '#16c784' },
            ].map(c => (
              <div class="gt-icard" style={`--c:${c.color}`}>
                <div class="gt-icard-icon">{c.icon}</div>
                <div class="gt-icard-label" style={`color:${c.color}`}>{c.label}</div>
                <div class="gt-icard-range">{c.range}</div>
                <div class="gt-icard-desc">{c.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

      <!-- Block 4: 快捷导航与操作 -->
      <div class="gt-block gt-nav-block" data-id="nav">
        <div class="gt-panel-head">
          <div class="gt-drag-handle" title="按住拖拽调整位置">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="9" cy="5" r="2"/>
              <circle cx="9" cy="12" r="2"/>
              <circle cx="9" cy="19" r="2"/>
              <circle cx="15" cy="5" r="2"/>
              <circle cx="15" cy="12" r="2"/>
              <circle cx="15" cy="19" r="2"/>
            </svg>
          </div>
          <h2 class="gt-panel-title" style="color: var(--text-secondary);">快捷导航与操作</h2>
        </div>
        <div class="gt-nav">
          <a href="/" class="gt-btn gt-btn-sec">← 返回主页</a>
          <a href="https://coinmarketcap.com/charts/fear-and-greed-index/" target="_blank" rel="noopener noreferrer" class="gt-btn gt-btn-cmc">CMC 完整报告 ↗</a>
          <a href="https://alternative.me/crypto/fear-and-greed-index/" target="_blank" rel="noopener noreferrer" class="gt-btn gt-btn-alt">Alternative.me ↗</a>
          <button id="gt-reset-layout" class="gt-btn gt-btn-reset">重置布局 ↺</button>
        </div>
        <div class="gt-resize-handle" title="拖动右下角调整大小"></div>
      </div>

    </div><!-- /gt-board -->

  </div><!-- /gt-container -->
</div><!-- /gt-wrapper -->
</Layout>

<script>
  // Immediately read and set theme to avoid FOUC (flash of unstyled content)
  const savedTheme = (() => {
    try {
      return localStorage.getItem('gt-theme') || 'dark';
    } catch (e) {
      return 'dark';
    }
  })();
  document.documentElement.setAttribute('data-theme', savedTheme);

  document.addEventListener('DOMContentLoaded', () => {
    // Theme Toggler functionality
    const themeBtns = document.querySelectorAll('[data-theme-val]');
    
    function setTheme(theme: string) {
      document.documentElement.setAttribute('data-theme', theme);
      themeBtns.forEach(btn => {
        if (btn.getAttribute('data-theme-val') === theme) {
          btn.classList.add('gt-active');
        } else {
          btn.classList.remove('gt-active');
        }
      });
      try {
        localStorage.setItem('gt-theme', theme);
      } catch (err) {}
    }

    setTheme(savedTheme);

    themeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const val = btn.getAttribute('data-theme-val');
        if (val) {
          setTheme(val);
        }
      });
    });

    // Grid Layout engine functionality
    const container = document.querySelector('.gt-board') as HTMLElement | null;
    if (!container) return;

    const ROW_HEIGHT = 220; // 220px per row cell height

    // Standard hardcoded layout as default
    const defaultLayout = {
      'altme':     { col: 1, row: 1, w: 2, h: 2 },
      'cmc-gauge': { col: 3, row: 1, w: 4, h: 2 },
      'cmc-chart': { col: 1, row: 3, w: 6, h: 2 },
      'nav':       { col: 1, row: 5, w: 6, h: 1 }
    };

    let layout = {} as any;
    try {
      const saved = localStorage.getItem('gt-layout-grid-v2');
      if (saved) {
        layout = JSON.parse(saved);
      }
    } catch (e) {
      console.error('Failed to load grid layout:', e);
    }

    // Merge layout config
    Object.keys(defaultLayout).forEach(key => {
      if (!layout[key] || typeof layout[key].col !== 'number') {
        layout[key] = { ...(defaultLayout as any)[key] };
      }
    });

    const blocks = container.querySelectorAll('.gt-block');

    function applyLayout() {
      blocks.forEach(block => {
        const id = block.getAttribute('data-id');
        if (id && layout[id]) {
          const cfg = layout[id];
          const el = block as HTMLElement;
          el.style.gridColumn = `${cfg.col} / span ${cfg.w}`;
          el.style.gridRow = `${cfg.row} / span ${cfg.h}`;
        }
      });
    }

    // Set square cell row heights dynamically
    function updateRowHeight() {
      const width = container!.getBoundingClientRect().width;
      const colWidth = width / 6; // 6 columns
      container!.style.setProperty('--row-height', `${colWidth.toFixed(1)}px`);
    }

    applyLayout();
    updateRowHeight();

    window.addEventListener('resize', updateRowHeight);

    // Reset layout trigger
    const resetBtn = document.getElementById('gt-reset-layout');
    if (resetBtn) {
      resetBtn.addEventListener('click', (e) => {
        e.preventDefault();
        try {
          localStorage.removeItem('gt-layout-grid-v2');
        } catch (err) {}
        layout = JSON.parse(JSON.stringify(defaultLayout));
        applyLayout();
        updateRowHeight();
      });
    }

    // Ghost layout guide placeholder
    const ghost = document.createElement('div');
    ghost.className = 'gt-grid-ghost';
    ghost.style.display = 'none';
    container.appendChild(ghost);

    let activeId = null as string | null;
    let isDragging = false;
    let isResizing = false;

    let initialMouseX = 0;
    let initialMouseY = 0;

    let initialCol = 1;
    let initialRow = 1;
    let initialWSpan = 1;
    let initialHSpan = 1;

    let initialWidth = 0;
    let initialHeight = 0;

    let blockRect = null as DOMRect | null;
    let containerRect = null as DOMRect | null;
    let currentBlockEl = null as HTMLElement | null;

    container.addEventListener('mousedown', (e) => {
      // Don't intercept clicks inside links/buttons
      if ((e.target as HTMLElement).closest('a') || (e.target as HTMLElement).closest('button')) {
        return;
      }

      const handle = (e.target as HTMLElement).closest('.gt-drag-handle');
      const resize = (e.target as HTMLElement).closest('.gt-resize-handle');

      if (handle) {
        e.preventDefault();
        currentBlockEl = handle.closest('.gt-block') as HTMLElement;
        if (!currentBlockEl) return;

        activeId = currentBlockEl.getAttribute('data-id');
        isDragging = true;

        containerRect = container.getBoundingClientRect();
        blockRect = currentBlockEl.getBoundingClientRect();

        initialMouseX = e.clientX;
        initialMouseY = e.clientY;

        const cfg = layout[activeId!];
        initialCol = cfg.col;
        initialRow = cfg.row;
        initialWSpan = cfg.w;
        initialHSpan = cfg.h;

        currentBlockEl.classList.add('gt-dragging');

        ghost.style.gridColumn = currentBlockEl.style.gridColumn;
        ghost.style.gridRow = currentBlockEl.style.gridRow;
        ghost.style.display = 'block';
      }
      else if (resize) {
        e.preventDefault();
        currentBlockEl = resize.closest('.gt-block') as HTMLElement;
        if (!currentBlockEl) return;

        activeId = currentBlockEl.getAttribute('data-id');
        isResizing = true;

        containerRect = container.getBoundingClientRect();
        blockRect = currentBlockEl.getBoundingClientRect();

        initialMouseX = e.clientX;
        initialMouseY = e.clientY;

        initialWidth = blockRect.width;
        initialHeight = blockRect.height;

        const cfg = layout[activeId!];
        initialCol = cfg.col;
        initialRow = cfg.row;
        initialWSpan = cfg.w;
        initialHSpan = cfg.h;

        currentBlockEl.classList.add('gt-resizing');

        ghost.style.gridColumn = currentBlockEl.style.gridColumn;
        ghost.style.gridRow = currentBlockEl.style.gridRow;
        ghost.style.display = 'block';
      }
    });

    document.addEventListener('mousemove', (e) => {
      if (!activeId || !currentBlockEl) return;

      containerRect = container.getBoundingClientRect();
      const colWidth = containerRect.width / 6;

      if (isDragging) {
        const deltaX = e.clientX - initialMouseX;
        const deltaY = e.clientY - initialMouseY;

        const mouseRelativeX = e.clientX - containerRect.left;
        const mouseRelativeY = e.clientY - containerRect.top;

        let targetCol = Math.floor(mouseRelativeX / colWidth) + 1;
        let targetRow = Math.floor(mouseRelativeY / colWidth) + 1;

        // Bounds constraints
        targetCol = Math.max(1, Math.min(6 - initialWSpan + 1, targetCol));
        targetRow = Math.max(1, targetRow);

        ghost.style.gridColumn = `${targetCol} / span ${initialWSpan}`;
        ghost.style.gridRow = `${targetRow} / span ${initialHSpan}`;

        currentBlockEl.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
        currentBlockEl.style.zIndex = '100';
        currentBlockEl.style.pointerEvents = 'none';
      }
      else if (isResizing) {
        const deltaX = e.clientX - initialMouseX;
        const deltaY = e.clientY - initialMouseY;

        const newWidth = initialWidth + deltaX;
        const newHeight = initialHeight + deltaY;

        let targetWSpan = Math.round(newWidth / colWidth);
        targetWSpan = Math.max(1, Math.min(6 - initialCol + 1, targetWSpan));

        let targetHSpan = Math.round(newHeight / colWidth); // square cells
        targetHSpan = Math.max(1, targetHSpan);

        ghost.style.gridColumn = `${initialCol} / span ${targetWSpan}`;
        ghost.style.gridRow = `${initialRow} / span ${targetHSpan}`;
      }
    });

    document.addEventListener('mouseup', () => {
      if (!activeId || !currentBlockEl) return;

      if (isDragging) {
        currentBlockEl.classList.remove('gt-dragging');
        currentBlockEl.style.transform = '';
        currentBlockEl.style.zIndex = '';
        currentBlockEl.style.pointerEvents = '';

        const colParts = ghost.style.gridColumn.split('/');
        const rowParts = ghost.style.gridRow.split('/');

        if (colParts.length && rowParts.length) {
          const finalCol = parseInt(colParts[0]);
          const finalRow = parseInt(rowParts[0]);

          if (!isNaN(finalCol) && !isNaN(finalRow)) {
            layout[activeId!].col = finalCol;
            layout[activeId!].row = finalRow;
          }
        }
      }
      else if (isResizing) {
        currentBlockEl.classList.remove('gt-resizing');

        const colParts = ghost.style.gridColumn.split('span');
        const rowParts = ghost.style.gridRow.split('span');

        if (colParts.length > 1 && rowParts.length > 1) {
          const finalWSpan = parseInt(colParts[1]);
          const finalHSpan = parseInt(rowParts[1]);

          if (!isNaN(finalWSpan) && !isNaN(finalHSpan)) {
            layout[activeId!].w = finalWSpan;
            layout[activeId!].h = finalHSpan;
          }
        }
      }

      // Save order
      try {
        localStorage.setItem('gt-layout-grid-v2', JSON.stringify(layout));
      } catch (err) {}

      applyLayout();
      updateRowHeight();

      ghost.style.display = 'none';
      activeId = null;
      isDragging = false;
      isResizing = false;
      currentBlockEl = null;
    });
  });
</script>

