                <circle cx="9" cy="5" r="2"></circle><circle
                  cx="9"
                  cy="12"
                  r="2"></circle><circle cx="9" cy="19" r="2"></circle>
                <circle cx="15" cy="5" r="2"></circle><circle
                  cx="15"
                  cy="12"
                  r="2"></circle><circle cx="15" cy="19" r="2"></circle>
              </svg>
            </div>
            <h2 class="gt-panel-title gt-cmc-title">
              <a
                href="https://coinmarketcap.com/charts/fear-and-greed-index/"
                target="_blank"
                rel="noopener noreferrer">CMC Gauge</a
              >
            </h2>
            <span class="gt-cmc-badge">CMC</span>
          </div>

          <a
            href="https://coinmarketcap.com/charts/fear-and-greed-index/"
            target="_blank"
            rel="noopener noreferrer"
            class="gt-cmc-body-link"
          >
            {
              cmcError ? (
                <div class="gt-placeholder">
                  {cmcError === "NO_KEY" ? (
                    <div class="gt-ph-inner">
                      <div class="gt-ph-icon">🔑</div>
