<!-- Inject Chart.js preloads in Browser -->
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"
></script>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js"
></script>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"
></script>

<script>
  // Immediately read and set theme to avoid FOUC
  const savedTheme = (() => {
    try {
      return localStorage.getItem("gt-theme-v2") || "paper";
    } catch (e) {
      return "paper";
    }
  })();
  document.documentElement.setAttribute("data-theme", savedTheme);

  document.addEventListener("DOMContentLoaded", () => {
    // Register plugins
    if (
      window.Chart &&
      window.chartjsPluginAnnotation &&
      window.chartjsPluginZoom
    ) {
      window.Chart.register(window.chartjsPluginAnnotation);
      window.Chart.register(window.chartjsPluginZoom);
    }

    // CMC Trend Chart Time Range Switcher (Original Restored)
    const chartContainer = document.getElementById("gt-chart-container");
    if (chartContainer) {
      const cmcDataStr = chartContainer.getAttribute("data-cmc");
      if (cmcDataStr) {
        try {
          const cmcData = JSON.parse(cmcDataStr);
          const tabs = chartContainer.querySelectorAll(".gt-tab-btn");
          const chartLabel = chartContainer.querySelector(".gt-chart-label");
          const polylineEl = chartContainer.querySelector(
            ".gt-line-chart polyline",
          );
          const areaEl = chartContainer.querySelector(".gt-line-chart polygon");
          const markerEl = chartContainer.querySelector(
            ".gt-line-chart circle",
          );
          const xAxisEl = chartContainer.querySelector(".gt-x-axis");

          const CW = 560;
          const CH = 100;
          const CPT = 6;

          const clientFmtDate = (ts: any) => {
            const ms = Number(ts) < 1e12 ? Number(ts) * 1000 : Number(ts);
            return new Date(ms).toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "short",
              day: "numeric",
            });
          };

          const clientValueColor = (v: number) => {
            if (v <= 20) return "#ea3943";
            if (v <= 40) return "#f97316";
            if (v <= 60) return "#eab308";
            if (v <= 80) return "#84cc16";
            return "#16c784";
          };

          const updateChart = (days: number) => {
            if (!cmcData || !cmcData.length) return;
            const chartRaw = cmcData.slice(0, days).reverse();
            const chartPts = chartRaw.map((d: any, i: number) => {
              const x =
                chartRaw.length > 1 ? (i / (chartRaw.length - 1)) * CW : CW / 2;
              const y = CPT + ((100 - d.value) / 100) * (CH - CPT * 2);
              return { x: +x.toFixed(2), y: +y.toFixed(2), v: d.value };
            });

            const polylinePoints = chartPts
              .map((p: any) => `${p.x},${p.y}`)
              .join(" ");
            const areaPoints = chartPts.length
              ? `0,${CH} ${polylinePoints} ${CW},${CH}`
              : "";

            if (polylineEl) {
              polylineEl.setAttribute("points", polylinePoints);
            }
            if (areaEl) {
              areaEl.setAttribute("points", areaPoints);
            }
            if (markerEl && chartPts.length > 0) {
              const lastPt = chartPts[chartPts.length - 1];
              markerEl.setAttribute("cx", String(lastPt.x));
              markerEl.setAttribute("cy", String(lastPt.y));
              markerEl.setAttribute("fill", clientValueColor(lastPt.v));
            }

            if (xAxisEl && chartRaw.length > 0) {
              const first = clientFmtDate(chartRaw[0].timestamp);
              const mid = clientFmtDate(
                chartRaw[Math.floor(chartRaw.length / 2)].timestamp,
              );
              const last = clientFmtDate(
                chartRaw[chartRaw.length - 1].timestamp,
              );
              xAxisEl.innerHTML = `<span>${first}</span><span>${mid}</span><span>${last}</span>`;
            }

            if (chartLabel) {
              let labelText = `过去 ${days} 天趋势`;
              if (days === 30) labelText = "过去 30 天趋势";
              else if (days === 365) labelText = "过去 1 年趋势";
              else if (days === 1095)
                labelText = "过去 3 年趋势 (实际数据1076天)";
              else if (days === 1825)
                labelText = "过去 5 年趋势 (自2023年8月上线起)";
              chartLabel.textContent = labelText;
            }
          };

          tabs.forEach((tab) => {
            tab.addEventListener("click", (e) => {
              e.preventDefault();
              tabs.forEach((t) => t.classList.remove("active"));
              tab.classList.add("active");
              const range = parseInt(
                tab.getAttribute("data-range") || "30",
                10,
              );
              updateChart(range);
            });
          });
        } catch (err) {
          console.error("Failed to parse CMC data:", err);
        }
      }
    }

    // --- Chart.js components initialization for Stock, Crypto, Gold ---
    const chartInstances: Record<string, any> = {};

    function getChartThemeColors() {
      const isLight =
        document.documentElement.getAttribute("data-theme") === "light";
      const isPaper =
        document.documentElement.getAttribute("data-theme") === "paper";
      return {
        gridColor: isLight
          ? "rgba(0, 0, 0, 0.05)"
          : isPaper
            ? "rgba(74, 53, 37, 0.07)"
            : "rgba(255, 255, 255, 0.06)",
        textColor: isLight ? "#475569" : isPaper ? "#6b4a32" : "#94a3b8",
      };
    }

    function initChart(canvasId: string) {
      const canvas = document.getElementById(
        canvasId,
      ) as HTMLCanvasElement | null;
      if (!canvas) return;

      const historyDataStr = canvas.getAttribute("data-history");
      if (!historyDataStr) return;

      const fullHistory = JSON.parse(historyDataStr);
      const label = canvas.getAttribute("data-label") || "Index";
      const color = canvas.getAttribute("data-color") || "#ffd700";
      const bgColor =
        canvas.getAttribute("data-bg") || "rgba(255, 215, 0, 0.05)";

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      function getFilteredDataset(days: string | number) {
        if (days === "all" || !days) return [...fullHistory];
        const count = Number(days);
        return fullHistory.slice(-count);
      }

      const currentColors = getChartThemeColors();

      const render = (days: string | number) => {
        const data = getFilteredDataset(days);
        const labels = data.map((item: any) =>
          new Date(item.timestamp).toLocaleDateString("zh-CN", {
            month: "short",
            day: "numeric",
          }),
        );
        const values = data.map((item: any) => item.value);

        if (chartInstances[canvasId]) {
          chartInstances[canvasId].destroy();
        }

        chartInstances[canvasId] = new window.Chart(ctx, {
          type: "line",
          data: {
            labels: labels,
            datasets: [
              {
                label: label,
                data: values,
                borderColor: color,
                backgroundColor: bgColor,
                borderWidth: 2,
                pointRadius: 0,
                pointHoverRadius: 6,
                hitRadius: 20,
                fill: true,
                tension: 0.15,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
              mode: "index",
              intersect: false,
            },
            scales: {
              y: {
                min: 0,
                max: 100,
                ticks: {
                  stepSize: 20,
                  color: currentColors.textColor,
                  font: { size: 9 },
                },
                grid: {
                  color: currentColors.gridColor,
                },
              },
              x: {
                grid: { display: false },
                ticks: {
                  maxRotation: 0,
                  autoSkip: true,
                  maxTicksLimit: 6,
                  color: currentColors.textColor,
                  font: { size: 9 },
                },
              },
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: "rgba(10, 10, 20, 0.95)",
                titleColor: "#fff",
                bodyColor: "#fff",
                borderColor: "rgba(255,255,255,0.1)",
                borderWidth: 1,
                callbacks: {
                  label: function (context: any) {
                    const value = context.parsed.y;
                    let sentiment = "中性";
                    if (value <= 25) sentiment = "极度恐惧";
                    else if (value <= 45) sentiment = "恐惧";
                    else if (value <= 55) sentiment = "中性";
                    else if (value <= 75) sentiment = "贪婪";
                    else sentiment = "极度贪婪";
                    return ` ${label}: ${Math.round(value)} (${sentiment})`;
                  },
                },
              },
              annotation: {
                annotations: {
                  neutralLine: {
                    type: "line",
                    yMin: 50,
                    yMax: 50,
                    borderColor: "rgba(150, 150, 150, 0.3)",
                    borderWidth: 1,
                    borderDash: [5, 5],
                  },
                  fearLine: {
                    type: "line",
                    yMin: 25,
                    yMax: 25,
                    borderColor: "rgba(220, 53, 69, 0.2)",
                    borderWidth: 1,
                    borderDash: [4, 4],
                  },
                  greedLine: {
                    type: "line",
                    yMin: 75,
                    yMax: 75,
                    borderColor: "rgba(40, 167, 69, 0.2)",
                    borderWidth: 1,
                    borderDash: [4, 4],
                  },
                },
              },
            },
          },
        });
      };

      render(30);
      (canvas as any)._updateChartRange = render;
    }

    initChart("crypto-chart");
    initChart("gold-chart");
    initChart("stock-chart");

    const tabContainers = document.querySelectorAll(
      ".gt-chart-tabs[data-target]",
    );
    tabContainers.forEach((container) => {
      const target = container.getAttribute("data-target");
      const canvas = document.getElementById(`${target}-chart`) as any;
      if (!canvas) return;

      const buttons = container.querySelectorAll(".gt-tab-btn");
      buttons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          buttons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          const range = btn.getAttribute("data-range") || "30";
          if (canvas._updateChartRange) {
            canvas._updateChartRange(range);
          }
        });
      });
    });

    // Theme Toggler functionality (Restored + Augmented)
    const themeBtns = document.querySelectorAll("[data-theme-val]");

    function setTheme(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      themeBtns.forEach((btn) => {
        if (btn.getAttribute("data-theme-val") === theme) {
          btn.classList.add("gt-active");
        } else {
          btn.classList.remove("gt-active");
        }
      });
      try {
        localStorage.setItem("gt-theme-v2", theme);
      } catch (err) {}

      // Update Chart.js themes
      const colors = getChartThemeColors();
      Object.values(chartInstances).forEach((chart: any) => {
        if (chart?.options?.scales) {
          chart.options.scales.y.grid.color = colors.gridColor;
          chart.options.scales.y.ticks.color = colors.textColor;
          chart.options.scales.x.ticks.color = colors.textColor;
          chart.update();
        }
      });
    }

    setTheme(savedTheme);

    themeBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const val = btn.getAttribute("data-theme-val");
        if (val) {
          setTheme(val);
        }
      });
    });

    // Grid Layout engine functionality (Restored & Augmented for 10 widgets)
    const container = document.querySelector(".gt-board") as HTMLElement | null;
    if (!container) return;

    // Default layout containing all 10 widgets
    const defaultLayout = {
      altme: { col: 1, row: 1, w: 2, h: 2 },
      "cmc-gauge": { col: 3, row: 1, w: 4, h: 2 },
      "crypto-index": { col: 1, row: 3, w: 2, h: 2 },
      "gold-index": { col: 3, row: 3, w: 2, h: 2 },
      "stock-index": { col: 5, row: 3, w: 2, h: 2 },
      "cmc-chart": { col: 1, row: 5, w: 6, h: 2 },
      "crypto-trend": { col: 1, row: 7, w: 6, h: 2 },
      "gold-trend": { col: 1, row: 9, w: 6, h: 2 },
      "stock-trend": { col: 1, row: 11, w: 6, h: 2 },
      nav: { col: 1, row: 13, w: 6, h: 1 },
    };

    let layout = {} as any;
    try {
      const saved = localStorage.getItem("gt-layout-grid-v10");
      if (saved) {
        layout = JSON.parse(saved);
      }
    } catch (e) {
      console.error("Failed to load grid layout:", e);
    }

    // Merge layout config
    Object.keys(defaultLayout).forEach((key) => {
      if (!layout[key] || typeof layout[key].col !== "number") {
        layout[key] = { ...(defaultLayout as any)[key] };
      }
    });

    const blocks = container.querySelectorAll(".gt-block");

    function applyLayout() {
      blocks.forEach((block) => {
        const id = block.getAttribute("data-id");
        if (id && layout[id]) {
          const cfg = layout[id];
          const el = block as HTMLElement;
          el.style.gridColumn = `${cfg.col} / span ${cfg.w}`;
          el.style.gridRow = `${cfg.row} / span ${cfg.h}`;
        }
      });
    }

    // Set square cell row heights dynamically
    function updateRowHeight() {
      const width = container!.getBoundingClientRect().width;
      const colWidth = width / 6; // 6 columns
      container!.style.setProperty("--row-height", `${colWidth.toFixed(1)}px`);
    }

    applyLayout();
    updateRowHeight();

    window.addEventListener("resize", updateRowHeight);

    // Reset layout trigger
    const resetBtn = document.getElementById("gt-reset-layout");
    if (resetBtn) {
      resetBtn.addEventListener("click", (e) => {
        e.preventDefault();
        try {
          localStorage.removeItem("gt-layout-grid-v10");
        } catch (err) {}
        layout = JSON.parse(JSON.stringify(defaultLayout));
        applyLayout();
        updateRowHeight();
      });
    }

    // Ghost layout guide placeholder
    const ghost = document.createElement("div");
    ghost.className = "gt-grid-ghost";
    ghost.style.display = "none";
    container.appendChild(ghost);

    let activeId: string | null = null;
    let isDragging = false;
    let isResizing = false;

    let initialMouseX = 0;
    let initialMouseY = 0;

    let initialCol = 1;
    let initialRow = 1;
    let initialWSpan = 1;
    let initialHSpan = 1;

    let initialWidth = 0;
    let initialHeight = 0;

    let blockRect: DOMRect | null = null;
    let containerRect: DOMRect | null = null;
    let currentBlockEl: HTMLElement | null = null;

    container.addEventListener("mousedown", (e) => {
      // Don't intercept clicks inside links/buttons/tabs
      if (
        (e.target as HTMLElement).closest("a") ||
        (e.target as HTMLElement).closest("button")
      ) {
        return;
      }

      const handle = (e.target as HTMLElement).closest(".gt-drag-handle");
      const resize = (e.target as HTMLElement).closest(".gt-resize-handle");

      if (handle) {
        e.preventDefault();
        currentBlockEl = handle.closest(".gt-block") as HTMLElement;
        if (!currentBlockEl) return;

        activeId = currentBlockEl.getAttribute("data-id");
        isDragging = true;

        containerRect = container.getBoundingClientRect();
        blockRect = currentBlockEl.getBoundingClientRect();

        initialMouseX = e.clientX;
        initialMouseY = e.clientY;

        const cfg = layout[activeId!];
        initialCol = cfg.col;
        initialRow = cfg.row;
        initialWSpan = cfg.w;
        initialHSpan = cfg.h;

        currentBlockEl.classList.add("gt-dragging");

        ghost.style.gridColumn = currentBlockEl.style.gridColumn;
        ghost.style.gridRow = currentBlockEl.style.gridRow;
        ghost.style.display = "block";
      } else if (resize) {
        e.preventDefault();
        currentBlockEl = resize.closest(".gt-block") as HTMLElement;
        if (!currentBlockEl) return;

        activeId = currentBlockEl.getAttribute("data-id");
        isResizing = true;

        containerRect = container.getBoundingClientRect();
        blockRect = currentBlockEl.getBoundingClientRect();

        initialMouseX = e.clientX;
        initialMouseY = e.clientY;

        initialWidth = blockRect.width;
        initialHeight = blockRect.height;

        const cfg = layout[activeId!];
        initialCol = cfg.col;
        initialRow = cfg.row;
        initialWSpan = cfg.w;
        initialHSpan = cfg.h;

        currentBlockEl.classList.add("gt-resizing");

        ghost.style.gridColumn = currentBlockEl.style.gridColumn;
        ghost.style.gridRow = currentBlockEl.style.gridRow;
        ghost.style.display = "block";
      }
    });

    document.addEventListener("mousemove", (e) => {
      if (!activeId || !currentBlockEl) return;

      containerRect = container.getBoundingClientRect();
      const colWidth = containerRect.width / 6;

      if (isDragging) {
        const deltaX = e.clientX - initialMouseX;
        const deltaY = e.clientY - initialMouseY;

        const mouseRelativeX = e.clientX - containerRect.left;
        const mouseRelativeY = e.clientY - containerRect.top;

        let targetCol = Math.floor(mouseRelativeX / colWidth) + 1;
        let targetRow = Math.floor(mouseRelativeY / colWidth) + 1;

        // Bounds constraints (6 columns grid)
        targetCol = Math.max(1, Math.min(6 - initialWSpan + 1, targetCol));
        targetRow = Math.max(1, targetRow);

        ghost.style.gridColumn = `${targetCol} / span ${initialWSpan}`;
        ghost.style.gridRow = `${targetRow} / span ${initialHSpan}`;

        currentBlockEl.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
        currentBlockEl.style.zIndex = "100";
        currentBlockEl.style.pointerEvents = "none";
      } else if (isResizing) {
        const deltaX = e.clientX - initialMouseX;
        const deltaY = e.clientY - initialMouseY;

        const newWidth = initialWidth + deltaX;
        const newHeight = initialHeight + deltaY;

        let targetWSpan = Math.round(newWidth / colWidth);
        targetWSpan = Math.max(1, Math.min(6 - initialCol + 1, targetWSpan));

        let targetHSpan = Math.round(newHeight / colWidth);
        targetHSpan = Math.max(1, targetHSpan);

        ghost.style.gridColumn = `${initialCol} / span ${targetWSpan}`;
        ghost.style.gridRow = `${initialRow} / span ${targetHSpan}`;
      }
    });

    document.addEventListener("mouseup", () => {
      if (!activeId || !currentBlockEl) return;

      if (isDragging) {
        currentBlockEl.classList.remove("gt-dragging");
        currentBlockEl.style.transform = "";
        currentBlockEl.style.zIndex = "";
        currentBlockEl.style.pointerEvents = "";

        const colParts = ghost.style.gridColumn.split("/");
        const rowParts = ghost.style.gridRow.split("/");

        if (colParts.length && rowParts.length) {
          const finalCol = parseInt(colParts[0]);
          const finalRow = parseInt(rowParts[0]);

          if (!isNaN(finalCol) && !isNaN(finalRow)) {
            layout[activeId!].col = finalCol;
            layout[activeId!].row = finalRow;
          }
        }
      } else if (isResizing) {
        currentBlockEl.classList.remove("gt-resizing");

        const colParts = ghost.style.gridColumn.split("span");
        const rowParts = ghost.style.gridRow.split("span");

        if (colParts.length > 1 && rowParts.length > 1) {
          const finalWSpan = parseInt(colParts[1]);
          const finalHSpan = parseInt(rowParts[1]);

          if (!isNaN(finalWSpan) && !isNaN(finalHSpan)) {
            layout[activeId!].w = finalWSpan;
            layout[activeId!].h = finalHSpan;
          }
        }
      }

      // Save order
      try {
        localStorage.setItem("gt-layout-grid-v10", JSON.stringify(layout));
        console.log("Current Layout JSON:", JSON.stringify(layout));
      } catch (err) {}

      applyLayout();
      updateRowHeight();

      // Trigger resize update on Chart.js charts
      Object.values(chartInstances).forEach((chart: any) => {
        chart.resize();
      });

      ghost.style.display = "none";
      activeId = null;
      isDragging = false;
      isResizing = false;
      currentBlockEl = null;
    });
  });
</script>

<style is:global>
  /* ── Reset & CSS Custom Theme Variables ── */
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    /* Theme Option 1: Cyber Dark (Default) */
    --bg-color: #06060f;
    --text-primary: #e2e8f0;
    --text-secondary: rgba(226, 232, 240, 0.45);
    --orbs-opacity: 0.15;
    --board-bg: rgba(255, 255, 255, 0.03);
    --block-bg: rgba(10, 10, 20, 0.95);
    --border-color: rgba(255, 255, 255, 0.08);
    --title-gold: #ffd700;

    --badge-bg: rgba(99, 179, 237, 0.1);
    --badge-border: rgba(99, 179, 237, 0.25);
    --badge-color: #63b3ed;

    --pill-bg: rgba(255, 255, 255, 0.03);
    --pill-border: rgba(255, 255, 255, 0.06);

    --btn-bg: rgba(10, 10, 20, 0.95);
    --btn-sec-text: rgba(226, 232, 240, 0.7);
    --btn-sec-hover: rgba(255, 255, 255, 0.05);
    --btn-cmc-text: #63b3ed;
    --btn-cmc-hover: rgba(99, 179, 237, 0.12);
    --btn-alt-text: #f59e0b;
    --btn-alt-hover: rgba(245, 158, 11, 0.08);
    --btn-reset-text: rgba(255, 255, 255, 0.45);
    --btn-reset-hover: rgba(239, 68, 68, 0.1);

    --chart-grid-line: rgba(255, 255, 255, 0.07);
  }

  html[data-theme="light"] {
    /* Theme Option 2: Clean Light Mode */
    --bg-color: #f5f6fa;
    --text-primary: #1e293b;
    --text-secondary: rgba(30, 41, 59, 0.6);
    --orbs-opacity: 0.05;
    --board-bg: rgba(0, 0, 0, 0.02);
    --block-bg: #ffffff;
    --border-color: rgba(0, 0, 0, 0.09);
    --title-gold: #b27d00;

    --badge-bg: rgba(49, 130, 206, 0.08);
    --badge-border: rgba(49, 130, 206, 0.2);
    --badge-color: #2b6cb0;

    --pill-bg: rgba(0, 0, 0, 0.02);
    --pill-border: rgba(0, 0, 0, 0.05);

    --btn-bg: #ffffff;
    --btn-sec-text: #475569;
    --btn-sec-hover: rgba(0, 0, 0, 0.03);
    --btn-cmc-text: #2b6cb0;
    --btn-cmc-hover: rgba(49, 130, 206, 0.08);
    --btn-alt-text: #dd6b20;
    --btn-alt-hover: rgba(221, 107, 32, 0.06);
    --btn-reset-text: #64748b;
    --btn-reset-hover: rgba(239, 68, 68, 0.08);

    --chart-grid-line: rgba(0, 0, 0, 0.07);
  }

  html[data-theme="paper"] {
    /* Theme Option 3: Eye-Care Deep Ocean Teal */
    --bg-color: #003957;
    --text-primary: #e2e8f0;
    --text-secondary: rgba(226, 232, 240, 0.5);
    --orbs-opacity: 0.15;
    --board-bg: rgba(255, 255, 255, 0.04);
    --block-bg: #00283e;
    --border-color: rgba(255, 255, 255, 0.1);
    --title-gold: #ffd700;

    --badge-bg: rgba(255, 215, 0, 0.1);
    --badge-border: rgba(255, 215, 0, 0.25);
    --badge-color: #ffd700;

    --pill-bg: rgba(255, 255, 255, 0.04);
    --pill-border: rgba(255, 255, 255, 0.08);

    --btn-bg: #00283e;
    --btn-sec-text: rgba(226, 232, 240, 0.8);
    --btn-sec-hover: rgba(255, 255, 255, 0.06);
    --btn-cmc-text: #63b3ed;
    --btn-cmc-hover: rgba(99, 179, 237, 0.12);
    --btn-alt-text: #f59e0b;
    --btn-alt-hover: rgba(245, 158, 11, 0.08);
    --btn-reset-text: rgba(226, 232, 240, 0.5);
    --btn-reset-hover: rgba(239, 68, 68, 0.15);

    --chart-grid-line: rgba(255, 255, 255, 0.08);
  }

  html {
    font-size: 17px;
    background: var(--bg-color);
    color: var(--text-primary);
    transition:
      background 0.3s,
      color 0.3s;
  }

  body {
    min-height: 100vh;
    background: var(--bg-color);
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC",
      "Microsoft YaHei", sans-serif;
    color: var(--text-primary);
    overflow-x: hidden;
    line-height: 1.5;
    transition:
      background 0.3s,
      color 0.3s;
  }

  /* Page Wrapper */
  .gt-wrapper {
    min-height: 100vh;
    position: relative;
    display: flex;
    justify-content: center;
    padding: 2rem 2rem 4rem;
  }

  /* Floating Theme Selector */
  .gt-theme-selector {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    display: flex;
    gap: 0.4rem;
    background: var(--block-bg);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0.3rem;
    z-index: 1000;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(10px);
    transition:
      background 0.3s,
      border-color 0.3s;
  }

  .gt-theme-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    transition: all 0.2s;
    outline: none;
  }
  .gt-theme-btn:hover {
    background: var(--btn-sec-hover);
  }
  .gt-theme-btn.gt-active {
    background: var(--text-primary);
    color: var(--bg-color);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  /* Background orbs */
  .gt-orbs {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: var(--orbs-opacity);
    transition: opacity 0.3s;
  }
  .gt-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    animation: gt-float 12s ease-in-out infinite;
  }
  .gt-orb1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, #f59e0b, #ef4444);
    top: -12%;
    left: -8%;
  }
  .gt-orb2 {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, #8b5cf6, #3b82f6);
    bottom: -8%;
    right: -6%;
    animation-delay: -4s;
  }
  .gt-orb3 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, #10b981, #06b6d4);
    top: 45%;
    left: 58%;
    animation-delay: -7s;
  }

  @keyframes gt-float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(15px, -25px) scale(1.03);
    }
    66% {
      transform: translate(-12px, 15px) scale(0.98);
    }
  }

  /* Main Container */
  .gt-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1600px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Header */
  .gt-header {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .gt-badge {
    display: inline-block;
    padding: 0.3rem 1rem;
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--badge-color);
    letter-spacing: 0.06em;
    margin-bottom: 0.7rem;
    transition: all 0.3s;
  }

  .gt-title {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    background: linear-gradient(135deg, #ffd700 0%, #f59e0b 40%, #ef4444 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }

  .gt-sub {
    font-size: 1rem;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    transition: color 0.3s;
  }

  /* Board Grid (6 Columns) */
  .gt-board {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: var(--row-height, 220px);
    gap: 1px;
    background: var(--border-color);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    transition:
      background 0.3s,
      border-color 0.3s;
  }

  /* Ghost Preview Box */
  .gt-grid-ghost {
    background: rgba(59, 130, 246, 0.15);
    border: 2px dashed #3b82f6;
    border-radius: 12px;
    z-index: 5;
    pointer-events: none;
  }

  /* Blocks */
  .gt-block {
    background: var(--block-bg);
    display: flex;
    flex-direction: column;
    position: relative;
    transition:
      background 0.3s,
      box-shadow 0.3s,
      transform 0.3s;
    overflow: hidden;
  }

  .gt-block.gt-dragging {
    opacity: 0.7;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
    transition: none !important;
  }
  .gt-block.gt-resizing {
    opacity: 0.8;
    transition: none !important;
  }

  /* Drag handle */
  .gt-drag-handle {
    cursor: grab;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    opacity: 0.6;
    padding: 0.28rem;
    border-radius: 6px;
    transition:
      background 0.2s,
      color 0.2s,
      opacity 0.2s;
    user-select: none;
    flex-shrink: 0;
  }
  .gt-drag-handle:hover {
    background: var(--btn-sec-hover);
    color: var(--text-primary);
    opacity: 1;
  }
  .gt-drag-handle:active {
    cursor: grabbing;
  }

  /* Resize Handle */
  .gt-resize-handle {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 22px;
    height: 22px;
    cursor: se-resize;
    background: linear-gradient(
      135deg,
      transparent 50%,
      var(--text-secondary) 50%
    );
    opacity: 0.3;
    border-radius: 0 0 10px 0;
    transition:
      background 0.2s,
      opacity 0.2s;
    z-index: 15;
  }
  .gt-resize-handle:hover {
    opacity: 0.85;
  }

  /* Default Spans */
  .gt-altme {
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
  }
  .gt-cmc-gauge {
    grid-column: 3 / span 4;
    grid-row: 1 / span 2;
  }
  [data-id="crypto-index"] {
    grid-column: 1 / span 2;
    grid-row: 3 / span 2;
  }
  [data-id="gold-index"] {
    grid-column: 3 / span 2;
    grid-row: 3 / span 2;
  }
  [data-id="stock-index"] {
    grid-column: 5 / span 2;
    grid-row: 3 / span 2;
  }
  .gt-cmc-chart {
    grid-column: 1 / span 6;
    grid-row: 5 / span 2;
  }
  [data-id="crypto-trend"] {
    grid-column: 1 / span 6;
    grid-row: 7 / span 2;
  }
  [data-id="gold-trend"] {
    grid-column: 1 / span 6;
    grid-row: 9 / span 2;
  }
  [data-id="stock-trend"] {
    grid-column: 1 / span 6;
    grid-row: 11 / span 2;
  }
  .gt-nav-block {
    grid-column: 1 / span 6;
    grid-row: 13 / span 1;
  }

  /* Padding inside blocks */
  .gt-altme,
  .gt-cmc-gauge,
  .gt-cmc-chart,
  .gt-widget-index,
  .gt-widget-trend,
  .gt-nav-block {
    padding: 1.5rem;
  }

  .gt-panel-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    flex-shrink: 0;
  }

  .gt-panel-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--title-gold);
    line-height: 1.3;
    display: flex;
    align-items: center;
    margin: 0;
    transition: color 0.3s;
  }
  .gt-panel-title a {
    color: inherit;
    text-decoration: none;
  }
  .gt-panel-title a:hover {
    text-decoration: underline;
  }

  /* New Widgets Title Styles */
  .text-crypto {
    color: #5dade2;
  }
  .text-gold {
    color: #f5b041;
  }
  .text-stock {
    color: #52be80;
  }

  .gt-source {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-left: auto;
    transition: color 0.3s;
  }

  /* Altme link elements */
  .gt-img-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 10px;
    overflow: hidden;
    flex: 1;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
    margin-bottom: 0.5rem;
    min-height: 0;
  }
  .gt-img-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  }
  .gt-img-wrap {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gt-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 10px;
    transition: filter 0.3s;
  }
  .gt-img-ov {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    opacity: 0;
    transition: opacity 0.3s;
    border-radius: 10px;
  }
  .gt-img-link:hover .gt-img-ov {
    opacity: 1;
  }
  .gt-img-link:hover .gt-img {
    filter: brightness(0.6) blur(1.5px);
  }
  .gt-ov-icon {
    font-size: 2rem;
    animation: gt-pulse 1.6s ease-in-out infinite;
  }
  .gt-ov-text {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ffd700;
    letter-spacing: 0.06em;
  }
  @keyframes gt-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.14);
    }
  }

  .gt-hint {
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0.8;
    letter-spacing: 0.03em;
    flex-shrink: 0;
    transition: color 0.3s;
  }

  /* CMC Body Link */
  .gt-cmc-body-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: auto;
    min-height: 0;
  }
  .gt-cmc-body-link:hover {
    filter: brightness(1.03);
  }

  .gt-cmc-title {
    color: #63b3ed !important;
  }
  .gt-cmc-badge {
    margin-left: auto;
    padding: 0.2rem 0.6rem;
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    border-radius: 5px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--badge-color);
    letter-spacing: 0.06em;
    transition: all 0.3s;
  }

  /* Placeholder */
  .gt-placeholder {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
  }
  .gt-ph-inner {
    text-align: center;
  }
  .gt-ph-icon {
    font-size: 2.5rem;
    margin-bottom: 0.7rem;
  }
  .gt-ph-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
    transition: color 0.3s;
  }
  .gt-ph-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    transition: color 0.3s;
  }

  /* Gauge wrapping */
  .gt-gauge-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    border-top: 1px solid var(--border-color);
    margin-top: 0.3rem;
    padding-top: 1rem;
    min-height: 0;
    overflow-y: auto;
    transition: border-color 0.3s;
  }
  .gt-gauge {
    width: 100%;
    max-width: 220px;
    margin: 0 auto;
    display: block;
    flex-shrink: 0;
  }

  .gt-pills {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    flex-shrink: 0;
  }
  .gt-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    border-radius: 7px;
    padding: 0.36rem 0.65rem;
    transition: all 0.3s;
  }
  .gt-pill-label {
    font-size: 0.95rem;
    color: var(--text-secondary);
    transition: color 0.3s;
  }
  .gt-pill-val {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .gt-year {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border-color);
    border: 1px solid var(--border-color);
    border-radius: 9px;
    overflow: hidden;
    flex: 1;
    margin-top: auto;
    min-height: 80px;
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .gt-year-block {
    background: var(--block-bg);
    padding: 0.6rem 0.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.2rem;
    transition: background 0.3s;
  }
  .gt-year-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.3s;
  }
  .gt-year-d {
    font-size: 0.85rem;
    color: var(--text-secondary);
    opacity: 0.8;
    transition: color 0.3s;
  }

  /* Combined layout for original CMC chart */
  .gt-chart-info-combined {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }

  .gt-chart-wrap-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-height: 0;
  }
  .gt-chart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.2rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .gt-chart-label {
    font-size: 1rem;
    color: var(--text-secondary);
    transition: color 0.3s;
    margin: 0;
  }
  .gt-chart-tabs {
    display: flex;
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    border-radius: 6px;
    padding: 0.15rem;
  }

  .gt-tab-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .gt-tab-btn:hover {
    color: var(--text-primary);
    background: var(--btn-sec-hover);
  }
  .gt-tab-btn.active {
    color: var(--bg-color);
    background: var(--text-primary);
  }
  .gt-chart-wrap {
    position: relative;
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 0.4rem 0.4rem 1.6rem 2.3rem;
    transition: border-color 0.3s;
  }
  .gt-line-chart {
    width: 100%;
    height: 110px;
    display: block;
    overflow: visible;
  }
  .gt-y-axis {
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 1.6rem;
    width: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding-right: 0.28rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0.7;
    pointer-events: none;
    transition: color 0.3s;
  }
  .gt-x-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0.7;
    transition: color 0.3s;
  }
  .gt-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    margin-top: 0.2rem;
  }
  .gt-legend-item {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    transition: color 0.3s;
  }
  .gt-legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Info cards */
  .gt-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1px;
    background: var(--border-color);
    flex-shrink: 0;
    transition: background 0.3s;
  }
  .gt-icard {
    background: var(--block-bg);
    border: none;
    border-top: 3px solid var(--c, rgba(255, 255, 255, 0.12));
    padding: 1.2rem 0.65rem;
    text-align: center;
    transition: background 0.3s;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 130px;
  }
  .gt-icard:hover {
    background: var(--btn-sec-hover);
  }
  .gt-icard-icon {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .gt-icard-label {
    font-size: 1.02rem;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }
  .gt-icard-range {
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    font-variant-numeric: tabular-nums;
    transition: color 0.3s;
  }
  .gt-icard-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.3;
    transition: color 0.3s;
  }

  /* ==================== NEW COMPONENTS SPECIFIC STYLES ==================== */
  .gt-widget-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: auto;
  }

  .gt-gauge-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 0.5rem;
  }

  .gt-sub-metrics {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.2rem;
  }

  .gt-sub-metric-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }
  .gt-sub-metric-row span:first-child {
    color: var(--text-secondary);
  }
  .gt-sub-metric-row span:last-child {
    font-weight: 600;
  }

  .gt-year-highlow {
    width: 100%;
    display: flex;
    justify-content: space-around;
    font-size: 0.78rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
    padding-top: 0.4rem;
    margin-top: auto;
