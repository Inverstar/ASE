                        stroke={z.color}
                        stroke-width="13"
                        fill="none"
                        stroke-linecap="butt"
                        opacity="0.9"
                      />
                    ))}
                    <path
                      d={gaugeArc(GCX, GCY, GR - 22, 0, 100)}
                      stroke="rgba(255,255,255,0.05)"
                      stroke-width="1"
                      fill="none"
                    />
                    <line
                      x1={GCX}
                      y1={GCY}
                      x2={needleTip.x.toFixed(2)}
                      y2={needleTip.y.toFixed(2)}
                      stroke={needleColor}
                      stroke-width="2.5"
                      stroke-linecap="round"
                    />
                    <circle cx={GCX} cy={GCY} r="5.5" fill={needleColor} />
                    <circle cx={GCX} cy={GCY} r="2.5" fill="var(--block-bg)" />
